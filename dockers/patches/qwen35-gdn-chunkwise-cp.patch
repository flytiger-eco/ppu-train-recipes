+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+
+"""Bitwise tests for the GDN headwise head-pack all-to-all optimization.
+
+The vectorized ``pack_head_sections_for_a2a`` CUDA kernel plus a single unsectioned
+all-to-all must be bitwise-identical to the community generic path
+(``_build_head_perm_for_split_sections`` + ``index_select`` + per-section split/concat).
+"""
+
+import pytest
+import torch
+
+from megatron.core.ssm.gated_delta_net.common import _build_head_perm_for_split_sections
+from megatron.core.ssm.gdn_head_pack import pack_head_sections_for_a2a
+
+
+@pytest.mark.parametrize("cp_size", [2, 4])
+def test_vectorized_head_pack_matches_generic_pack_bitwise(cp_size):
+    split_sections = (32, 32, 64, 64, 32, 32)
+    device = torch.device("cuda", torch.cuda.current_device())
+    head_perm = _build_head_perm_for_split_sections(split_sections, cp_size, device)
+
+    torch.manual_seed(123)
+    reference_input = torch.randn(7, 3, sum(split_sections), device=device, dtype=torch.bfloat16)
+    optimized_input = reference_input.detach().clone()
+    reference_input.requires_grad_(True)
+    optimized_input.requires_grad_(True)
+
+    permuted = reference_input.index_select(-1, head_perm)
+    flattened = permuted.reshape(-1, permuted.shape[-1])
+    reference_output = torch.cat(
+        torch.split(flattened, flattened.shape[-1] // cp_size, dim=-1), dim=0
+    )
+    optimized_output = pack_head_sections_for_a2a(optimized_input, split_sections, cp_size)
+    assert torch.equal(optimized_output, reference_output)
+
+    rows = reference_input.shape[0] * reference_input.shape[1]
+    packed_sections = torch.split(
+        optimized_output.reshape(cp_size, rows, -1),
+        [section // cp_size for section in split_sections],
+        dim=-1,
+    )
+    round_trip = torch.cat(
+        [section.transpose(0, 1).reshape(rows, -1) for section in packed_sections], dim=-1
+    ).reshape_as(optimized_input)
+    assert torch.equal(round_trip, optimized_input)
+
+    output_grad = torch.randn(
+        *reference_output.shape[:-1],
+        2 * reference_output.shape[-1],
+        device=device,
+        dtype=torch.bfloat16,
+    )[..., ::2]
+    assert not output_grad.is_contiguous()
+    reference_output.backward(output_grad)
+    optimized_output.backward(output_grad)
+    assert torch.equal(optimized_input.grad, reference_input.grad)
