+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+
+from functools import lru_cache
+
+import torch
+from torch.utils.cpp_extension import load_inline
+
+_CPP_SOURCE = r"""
+#include <torch/extension.h>
+
+#include <cstdint>
+#include <vector>
+
+torch::Tensor gdn_head_pack_forward_cuda(
+    torch::Tensor input, const std::vector<int64_t>& split_sections, int64_t cp_size);
+torch::Tensor gdn_head_pack_backward_cuda(
+    torch::Tensor grad_output, const std::vector<int64_t>& split_sections, int64_t cp_size);
+"""
+
+_CUDA_SOURCE = r"""
+#include <torch/extension.h>
+
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+namespace {
+
+constexpr int kSectionCount = 6;
+constexpr int kVectorBytes = 16;
+constexpr int kThreads = 256;
+constexpr int kMaxBlocks = 4096;
+
+struct PackMetadata {
+    int rows;
+    int input_width_vectors;
+    int output_width_vectors;
+    int cp_size;
+    int input_offsets[kSectionCount];
+    int chunk_widths[kSectionCount];
+};
+
+__device__ __forceinline__ int input_vector_index(
+    int output_column, int cp_rank, const PackMetadata& metadata) {
+    int local_offset = output_column;
+#pragma unroll
+    for (int section = 0; section < kSectionCount; ++section) {
+        const int chunk_width = metadata.chunk_widths[section];
+        if (local_offset < chunk_width) {
+            return metadata.input_offsets[section] + cp_rank * chunk_width + local_offset;
+        }
+        local_offset -= chunk_width;
+    }
+    return -1;
+}
+
+__global__ void pack_forward_kernel(
+    const uint4* __restrict__ input, uint4* __restrict__ output, PackMetadata metadata) {
+    const int total_vectors = metadata.rows * metadata.cp_size * metadata.output_width_vectors;
+    for (int index = blockIdx.x * blockDim.x + threadIdx.x; index < total_vectors;
+         index += blockDim.x * gridDim.x) {
+        const int output_column = index % metadata.output_width_vectors;
+        const int row_and_rank = index / metadata.output_width_vectors;
+        const int row = row_and_rank % metadata.rows;
+        const int cp_rank = row_and_rank / metadata.rows;
+        const int input_column = input_vector_index(output_column, cp_rank, metadata);
+        output[index] = input[row * metadata.input_width_vectors + input_column];
+    }
+}
+
+__global__ void pack_backward_kernel(
+    const uint4* __restrict__ grad_output,
+    uint4* __restrict__ grad_input,
+    PackMetadata metadata) {
+    const int total_vectors = metadata.rows * metadata.cp_size * metadata.output_width_vectors;
+    for (int index = blockIdx.x * blockDim.x + threadIdx.x; index < total_vectors;
+         index += blockDim.x * gridDim.x) {
+        const int output_column = index % metadata.output_width_vectors;
+        const int row_and_rank = index / metadata.output_width_vectors;
+        const int row = row_and_rank % metadata.rows;
+        const int cp_rank = row_and_rank / metadata.rows;
+        const int input_column = input_vector_index(output_column, cp_rank, metadata);
+        grad_input[row * metadata.input_width_vectors + input_column] = grad_output[index];
+    }
+}
+
+PackMetadata make_metadata(
+    int64_t rows, const std::vector<int64_t>& split_sections, int64_t cp_size) {
+    TORCH_CHECK(split_sections.size() == kSectionCount, "expected six GDN split sections");
+    TORCH_CHECK(cp_size > 1, "cp_size must be greater than one");
+    PackMetadata metadata{};
+    metadata.rows = static_cast<int>(rows);
+    metadata.cp_size = static_cast<int>(cp_size);
+    int input_offset = 0;
+    int output_width = 0;
+    for (int section = 0; section < kSectionCount; ++section) {
+        const int64_t width = split_sections[section];
+        TORCH_CHECK(width % (cp_size * 8) == 0, "each section must support 16-byte vector copies");
+        metadata.input_offsets[section] = input_offset;
+        metadata.chunk_widths[section] = static_cast<int>(width / cp_size / 8);
+        input_offset += static_cast<int>(width / 8);
+        output_width += metadata.chunk_widths[section];
+    }
+    metadata.input_width_vectors = input_offset;
+    metadata.output_width_vectors = output_width;
+    return metadata;
+}
+
+void check_tensor(const torch::Tensor& tensor) {
+    TORCH_CHECK(tensor.is_cuda(), "tensor must be on CUDA");
+    TORCH_CHECK(tensor.scalar_type() == torch::kBFloat16, "tensor must be bfloat16");
+    TORCH_CHECK(tensor.is_contiguous(), "tensor must be contiguous");
+    TORCH_CHECK(
+        reinterpret_cast<uintptr_t>(tensor.data_ptr()) % kVectorBytes == 0,
+        "tensor must be 16-byte aligned");
+}
+
+void check_launch() {
+    const cudaError_t error = cudaGetLastError();
+    TORCH_CHECK(error == cudaSuccess, "GDN head pack kernel launch failed: ", cudaGetErrorString(error));
+}
+
+}  // namespace
+
+torch::Tensor gdn_head_pack_forward_cuda(
+    torch::Tensor input, const std::vector<int64_t>& split_sections, int64_t cp_size) {
+    check_tensor(input);
+    c10::cuda::CUDAGuard device_guard(input.device());
+    const int64_t hidden_size = input.size(-1);
+    TORCH_CHECK(hidden_size % cp_size == 0, "hidden size must be divisible by cp_size");
+    const int64_t rows = input.numel() / hidden_size;
+    const PackMetadata metadata = make_metadata(rows, split_sections, cp_size);
+    TORCH_CHECK(metadata.input_width_vectors * 8 == hidden_size, "sections must cover hidden size");
+
+    auto output = torch::empty({rows * cp_size, hidden_size / cp_size}, input.options());
+    const int total_vectors = metadata.rows * metadata.cp_size * metadata.output_width_vectors;
+    const int blocks = std::min((total_vectors + kThreads - 1) / kThreads, kMaxBlocks);
+    const cudaStream_t stream = at::cuda::getCurrentCUDAStream(input.get_device());
+    pack_forward_kernel<<<blocks, kThreads, 0, stream>>>(
+        reinterpret_cast<const uint4*>(input.data_ptr()),
+        reinterpret_cast<uint4*>(output.data_ptr()),
+        metadata);
+    check_launch();
+    return output;
+}
+
+torch::Tensor gdn_head_pack_backward_cuda(
+    torch::Tensor grad_output, const std::vector<int64_t>& split_sections, int64_t cp_size) {
+    check_tensor(grad_output);
+    c10::cuda::CUDAGuard device_guard(grad_output.device());
+    TORCH_CHECK(grad_output.size(0) % cp_size == 0, "packed rows must be divisible by cp_size");
+    const int64_t rows = grad_output.size(0) / cp_size;
+    int64_t hidden_size = 0;
+    for (const int64_t section : split_sections) {
+        hidden_size += section;
+    }
+    TORCH_CHECK(grad_output.size(1) * cp_size == hidden_size, "packed width does not match sections");
+    const PackMetadata metadata = make_metadata(rows, split_sections, cp_size);
+
+    auto grad_input = torch::empty({rows, hidden_size}, grad_output.options());
+    const int total_vectors = metadata.rows * metadata.cp_size * metadata.output_width_vectors;
+    const int blocks = std::min((total_vectors + kThreads - 1) / kThreads, kMaxBlocks);
+    const cudaStream_t stream = at::cuda::getCurrentCUDAStream(grad_output.get_device());
+    pack_backward_kernel<<<blocks, kThreads, 0, stream>>>(
+        reinterpret_cast<const uint4*>(grad_output.data_ptr()),
+        reinterpret_cast<uint4*>(grad_input.data_ptr()),
+        metadata);
+    check_launch();
+    return grad_input;
+}
+"""
+
+
+@lru_cache(maxsize=None)
+def _get_gdn_head_pack_extension(compute_capability: tuple[int, int]):
+    major, minor = compute_capability
+    return load_inline(
+        name=f"gdn_head_pack_sm{major}{minor}",
+        cpp_sources=_CPP_SOURCE,
+        cuda_sources=_CUDA_SOURCE,
+        functions=["gdn_head_pack_forward_cuda", "gdn_head_pack_backward_cuda"],
+        extra_cflags=["-O3"],
+        extra_cuda_cflags=["-O3", "-lineinfo", f"-arch=sm_{major}{minor}"],
+        with_cuda=True,
+        verbose=False,
+    )
+
+
+class _GDNHeadPack(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, tensor, split_sections, cp_size):
+        ctx.input_shape = tensor.shape
+        ctx.split_sections = split_sections
+        ctx.cp_size = cp_size
+        extension = _get_gdn_head_pack_extension(torch.cuda.get_device_capability(tensor.device))
+        return extension.gdn_head_pack_forward_cuda(tensor.contiguous(), split_sections, cp_size)
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        extension = _get_gdn_head_pack_extension(torch.cuda.get_device_capability(grad_output.device))
+        grad_input = extension.gdn_head_pack_backward_cuda(
+            grad_output.contiguous(), ctx.split_sections, ctx.cp_size
+        )
+        return grad_input.reshape(ctx.input_shape), None, None
+
+
+def pack_head_sections_for_a2a(
+    tensor: torch.Tensor, split_sections: tuple[int, ...], cp_size: int
+) -> torch.Tensor:
+    return _GDNHeadPack.apply(tensor, split_sections, cp_size)
