+
+def main():
+    print("=" * 60)
+    print("Synthetic Dataset Generator for Cosmos3 Nano")
+    print("=" * 60)
+    print(f"  Samples: {NUM_SAMPLES}")
+    print(f"  Resolution: {WIDTH}x{HEIGHT}")
+    print(f"  FPS: {FPS}")
+    print(f"  Fixed frames: {NUM_FRAMES}")
+    print(f"  Output: {OUTPUT_DIR}")
+    print("=" * 60)
+
+    # Create directories
+    VIDEOS_DIR.mkdir(parents=True, exist_ok=True)
+    CAPTIONS_DIR.mkdir(parents=True, exist_ok=True)
+
+    # Generate seeds for reproducibility
+    master_seed = 42
+    r = random.Random(master_seed)
+    seeds = [(i, r.randint(0, 2**31)) for i in range(NUM_SAMPLES)]
+
+    # Use multiprocessing for speed
+    num_workers = 4
+    print(f"\nUsing {num_workers} worker processes...")
+    print(f"Starting generation at {time.strftime('%H:%M:%S')}\n")
+
+    start_time = time.time()
+    results = []
+    completed = 0
+    failed = 0
+
+    with Pool(processes=num_workers) as pool:
+        for result in pool.imap_unordered(generate_sample, seeds, chunksize=10):
+            if result is not None:
+                results.append(result)
+                completed += 1
+            else:
+                failed += 1
+
+            total = completed + failed
+            if total % 50 == 0 or total == NUM_SAMPLES:
+                elapsed = time.time() - start_time
+                rate = total / elapsed if elapsed > 0 else 0
+                eta = (NUM_SAMPLES - total) / rate if rate > 0 else 0
+                print(f"  Progress: {total}/{NUM_SAMPLES} "
+                      f"({completed} ok, {failed} failed) "
+                      f"| {rate:.1f} samples/s | ETA: {eta:.0f}s")
+
+    elapsed_total = time.time() - start_time
+
+    # Sort results by index for consistent JSONL ordering
+    results.sort(key=lambda x: x["idx"])
+
+    # Write JSONL file
+    jsonl_path = TRAIN_DIR / "video_dataset_file.jsonl"
+    with open(jsonl_path, "w") as f:
+        for result in results:
+            f.write(json.dumps(result["jsonl_entry"]) + "\n")
+
+    # Statistics
+    caption_lengths = []
+    for result in results:
+        caption_lengths.append(result["caption_length"])
+
+    avg_caption_len = sum(caption_lengths) / len(caption_lengths) if caption_lengths else 0
+    min_caption_len = min(caption_lengths) if caption_lengths else 0
+    max_caption_len = max(caption_lengths) if caption_lengths else 0
+
+    print("\n" + "=" * 60)
+    print("GENERATION COMPLETE")
+    print("=" * 60)
+    print(f"  Total time: {elapsed_total:.1f}s ({elapsed_total/60:.1f} min)")
+    print(f"  Successful samples: {completed}")
+    print(f"  Failed samples: {failed}")
+    print(f"\n  Frame count: {NUM_FRAMES} frames (N=20, {NUM_FRAMES/FPS:.2f}s) x {completed} samples")
+    print(f"\n  Caption text statistics:")
+    print(f"    Average length: {avg_caption_len:.0f} chars (~{avg_caption_len/4:.0f} tokens)")
+    print(f"    Min length: {min_caption_len} chars (~{min_caption_len/4:.0f} tokens)")
+    print(f"    Max length: {max_caption_len} chars (~{max_caption_len/4:.0f} tokens)")
+    print(f"\n  Output files:")
+    print(f"    JSONL: {jsonl_path}")
+    print(f"    Videos: {VIDEOS_DIR}/ ({completed} files)")
+    print(f"    Captions: {CAPTIONS_DIR}/ ({completed} dirs)")
+    print("=" * 60)
+
+
+if __name__ == "__main__":
+    main()
