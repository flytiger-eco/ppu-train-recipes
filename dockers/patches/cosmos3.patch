 import torch
+import torch.multiprocessing
+torch.multiprocessing.set_sharing_strategy('file_system')
+# PPU (39 SMs): Inductor's mix-order reduction heuristic picks split_size=128
+# -> XBLOCK=4 -> the 3-stage pipeline needs ~426KB smem, exceeding the 256KB
+# per-SM limit ("No valid triton configs ... out of resource: shared memory").
+# Pin split_size=32 to reproduce the shape a 132-SM GPU computes automatically
+# (~106KB). Only needed on torch 2.10.x: 2.11 already defaults NUM_STAGES=1 for
+# mix-order reduction kernels and is safe without this override.
+def _is_ppu() -> bool:
+    try:
+        from torch.testing._utils import is_ppu  # torch>=2.11 PPU wheel
+
+        return is_ppu()
+    except ImportError:
+        return "PPU_SDK" in os.environ  # same check as torch's is_ppu
+
+
+if _is_ppu() and torch.__version__.startswith("2.10."):
+    import torch._inductor.config
+
+    torch._inductor.config.triton.mix_order_reduction_split_size = 32
