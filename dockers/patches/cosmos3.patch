+++ b/scripts/generate_synthetic_data.py
@@ -0,0 +1,434 @@
+#!/usr/bin/env python3
+"""
+Generate 1000 synthetic training samples for Cosmos3 Nano.
+
+Samples include:
+- Synthetic MP4 videos (1920x1200, H.264, YUV420p, 30fps)
+- JSONL metadata
+- Caption files (json + txt)
+
+Frame counts: 4N+1 where N=20 → fixed 81 frames
+Text prompts: ~500-2000 tokens (2000-8000 English characters)
+"""
+
+import json
+import os
+import random
+import string
+import subprocess
+import time
+from multiprocessing import Pool, cpu_count
+from pathlib import Path
+
+# Configuration
+NUM_SAMPLES = 1000
+WIDTH = 1920
+HEIGHT = 1200
+FPS = 30
+NUM_FRAMES = 81  # Fixed: 4×20+1 = 81 frames
+MIN_CHARS = 2000  # ~500 tokens
+MAX_CHARS = 8000  # ~2000 tokens
+
+OUTPUT_DIR = Path("./examples/data/synthetic_1k_1920x1200")
+TRAIN_DIR = OUTPUT_DIR / "train"
+VIDEOS_DIR = TRAIN_DIR / "videos"
+CAPTIONS_DIR = TRAIN_DIR / "captions"
+
+# Word pools for generating descriptive text
+SCENES = [
+    "a vast ocean stretching to the horizon", "a dense forest with towering trees",
+    "an urban cityscape with modern buildings", "a serene mountain landscape",
+    "a bustling marketplace with colorful stalls", "a quiet library filled with ancient books",
+    "a futuristic space station orbiting Earth", "a tranquil garden with blooming flowers",
+    "a desert landscape with sand dunes", "a snowy tundra under northern lights",
+    "a vibrant coral reef underwater", "a medieval castle on a hilltop",
+    "a modern laboratory with advanced equipment", "a cozy cabin in the woods",
+    "a sunlit meadow with wildflowers", "a volcanic island with steam rising",
+]
+
+ACTIONS = [
+    "slowly rotating and revealing intricate details", "transitioning between different color palettes",
+    "displaying smooth geometric transformations", "showcasing particle effects flowing through space",
+    "rendering complex fractal patterns", "demonstrating fluid dynamics simulation",
+    "presenting layered transparency effects", "cycling through seasonal changes",
+    "morphing between abstract shapes", "revealing hidden patterns through light interaction",
+    "simulating atmospheric phenomena", "creating mesmerizing wave patterns",
+    "building structures from elemental components", "dissolving into fragments and reassembling",
+    "projecting holographic imagery", "generating procedural terrain features",
+]
+
+COLORS = [
+    "deep azure blue", "vibrant crimson red", "luminous golden yellow",
+    "rich emerald green", "soft lavender purple", "warm amber orange",
+    "cool teal cyan", "dark obsidian black", "pure pearl white",
+    "metallic silver gray", "dusty rose pink", "burnt sienna brown",
+    "neon electric green", "pastel coral pink", "midnight navy blue",
+    "iridescent rainbow hues",
+]
+
+OBJECTS = [
+    "crystalline geometric structures", "organic flowing shapes",
+    "interconnected network nodes", "layered transparent planes",
+    "swirling vortex patterns", "fractal tree branches",
+    "spiraling helix formations", "tessellated mosaic tiles",
+    "floating ethereal orbs", "angular prismatic surfaces",
+    "undulating wave forms", "recursive nested shapes",
+    "radial symmetry patterns", "linear gradient bands",
+    "scattered point clouds", "interlocking gear mechanisms",
+]
+
+QUALITIES = [
+    "with stunning clarity and precision", "creating a hypnotic visual rhythm",
+    "evoking a sense of infinite depth", "producing harmonious visual balance",
+    "generating dynamic contrast and movement", "maintaining consistent visual coherence",
+    "exhibiting subtle textural variations", "demonstrating remarkable spatial complexity",
+    "achieving photorealistic material rendering", "displaying smooth temporal transitions",
+    "incorporating multi-layered visual depth", "featuring precisely calibrated color gradients",
+    "showcasing advanced rendering techniques", "producing cinematically composed frames",
+    "revealing microscopic detail patterns", "establishing atmospheric visual mood",
+]
+
+TRANSITIONS = [
+    "The scene then transitions smoothly into", "Following this sequence",
+    "As the animation progresses", "In the next segment",
+    "Gradually shifting focus to", "The visual narrative continues with",
+    "Building upon the previous elements", "Expanding the visual scope to include",
+    "Introducing new compositional elements", "The perspective then shifts to reveal",
+    "Moving forward in the sequence", "The temporal flow carries us toward",
+    "Evolving the visual landscape into", "The imagery then develops into",
+    "Progressing through the visual journey", "The composition then unfolds to show",
+]
+
+
+def generate_caption_text(target_chars: int) -> str:
+    """Generate a descriptive English text of approximately target_chars characters."""
+    paragraphs = []
+    current_length = 0
+
+    while current_length < target_chars:
+        # Build a paragraph from random components
+        sentences = []
+        num_sentences = random.randint(3, 7)
+
+        for i in range(num_sentences):
+            if i == 0 and paragraphs:
+                # Use a transition for continuity
+                transition = random.choice(TRANSITIONS)
+                scene = random.choice(SCENES)
+                sentence = f"{transition} {scene}"
+            else:
+                scene = random.choice(SCENES)
+                action = random.choice(ACTIONS)
+                color = random.choice(COLORS)
+                obj = random.choice(OBJECTS)
+                quality = random.choice(QUALITIES)
+
+                templates = [
+                    f"The visualization presents {scene}, featuring {obj} rendered in {color} tones, {action} {quality}.",
+                    f"Within this frame, {obj} emerge against the backdrop of {scene}, colored in {color}, {action}.",
+                    f"A striking composition shows {scene} where {obj} in {color} are {action} {quality}.",
+                    f"The sequence captures {obj} {action} within {scene}, painted in {color} hues {quality}.",
+                    f"Rendered with {color} highlights, {obj} appear within {scene}, {action} {quality}.",
+                    f"The visual narrative unfolds across {scene}, presenting {obj} in {color}, {action}.",
+                ]
+                sentence = random.choice(templates)
+
+            sentences.append(sentence)
+            current_length += len(sentence) + 1
+
+            if current_length >= target_chars:
+                break
+
+        paragraph = " ".join(sentences)
+        paragraphs.append(paragraph)
+
+    text = " ".join(paragraphs)
+    # Trim to approximate target length
+    if len(text) > target_chars + 200:
+        # Find a sentence boundary near the target
+        end_pos = text.rfind(".", 0, target_chars + 100)
+        if end_pos > target_chars - 200:
+            text = text[:end_pos + 1]
+
+    return text
+
+
+def generate_video_ffmpeg(video_path: str, num_frames: int, seed: int):
+    """Generate a synthetic video using ffmpeg with random color/pattern."""
+    duration = num_frames / FPS
+
+    # Use different lavfi sources for variety
+    pattern_type = seed % 5
+    r = random.Random(seed)
+    color1 = "#{:06x}".format(r.randint(0, 0xFFFFFF))
+    color2 = "#{:06x}".format(r.randint(0, 0xFFFFFF))
+
+    if pattern_type == 0:
+        # Solid color with noise
+        filtergraph = (
+            f"color=c='{color1}':s={WIDTH}x{HEIGHT}:d={duration}:r={FPS},"
+            f"noise=alls=30:allf=t"
+        )
+    elif pattern_type == 1:
+        # Gradient with temporal variation
+        filtergraph = (
+            f"gradients=s={WIDTH}x{HEIGHT}:d={duration}:r={FPS}:"
+            f"c0='{color1}':c1='{color2}':speed=0.5"
+        )
+    elif pattern_type == 2:
+        # Mandelbrot fractal
+        filtergraph = (
+            f"mandelbrot=s={WIDTH}x{HEIGHT}:r={FPS}:end_pts={duration}/TB"
+        )
+    elif pattern_type == 3:
+        # Test source with color bars variation
+        filtergraph = (
+            f"testsrc2=s={WIDTH}x{HEIGHT}:d={duration}:r={FPS}"
+        )
+    else:
+        # Color with drawtext overlay
+        filtergraph = (
+            f"color=c='{color1}':s={WIDTH}x{HEIGHT}:d={duration}:r={FPS},"
+            f"geq=r='clip(r(X,Y)+random(1)*50,0,255)':"
+            f"g='clip(g(X,Y)+random(2)*50,0,255)':"
+            f"b='clip(b(X,Y)+random(3)*50,0,255)'"
+        )
+
+    cmd = [
+        "ffmpeg", "-y",
+        "-f", "lavfi", "-i", filtergraph,
+        "-c:v", "libx264",
+        "-preset", "ultrafast",
+        "-pix_fmt", "yuv420p",
+        "-frames:v", str(num_frames),
+        "-loglevel", "error",
+        video_path
+    ]
+
+    try:
+        subprocess.run(cmd, check=True, capture_output=True, timeout=120)
+        return True
+    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as e:
+        # Fallback: simple color video
+        fallback_cmd = [
+            "ffmpeg", "-y",
+            "-f", "lavfi", "-i",
+            f"color=c='{color1}':s={WIDTH}x{HEIGHT}:d={duration}:r={FPS}",
+            "-c:v", "libx264",
+            "-preset", "ultrafast",
+            "-pix_fmt", "yuv420p",
+            "-frames:v", str(num_frames),
+            "-loglevel", "error",
+            video_path
+        ]
+        try:
+            subprocess.run(fallback_cmd, check=True, capture_output=True, timeout=120)
+            return True
+        except Exception:
+            return False
+
+
+def generate_sample(args):
+    """Generate a single sample (video + metadata)."""
+    idx, seed = args
+    r = random.Random(seed)
+
+    uuid = f"synthetic_{idx:06d}_clip000"
+    num_frames = NUM_FRAMES
+    duration = num_frames / FPS
+
+    # Generate caption text (2000-8000 chars ≈ 500-2000 tokens)
+    target_chars = r.randint(MIN_CHARS, MAX_CHARS)
+    caption_text = generate_caption_text(target_chars)
+
+    # Video path
+    video_filename = f"{uuid}.mp4"
+    video_path = str(VIDEOS_DIR / video_filename)
+
+    # Generate video
+    success = generate_video_ffmpeg(video_path, num_frames, seed)
+    if not success:
+        return None
+
+    # Create caption directory and files
+    caption_dir = CAPTIONS_DIR / uuid
+    caption_dir.mkdir(parents=True, exist_ok=True)
+
+    # Write caption.txt
+    with open(caption_dir / "caption.txt", "w") as f:
+        f.write(caption_text)
+
+    # Caption JSON structure
+    duration_str = f"{duration:.1f}s"
+    caption_json = {
+        "fps": FPS,
+        "duration": duration_str,
+        "resolution": {"H": HEIGHT, "W": WIDTH},
+        "aspect_ratio": "8,5",
+        "style_medium": "Synthetic video",
+        "artistic_style": "Abstract",
+        "subjects": [{
+            "description": "Abstract synthetic scene",
+            "appearance_details": "Colorful patterns and gradients",
+            "relationship": "Main content",
+            "location": "Center",
+            "relative_size": "Large",
+            "orientation": "Forward-facing",
+            "pose": "Static",
+            "action": "Displaying patterns",
+            "state_changes": "Color shifting",
+            "number_of_subjects": 1,
+            "number_of_arms": 0,
+            "number_of_legs": 0,
+            "clothing": "",
+            "expression": "",
+            "gender": "",
+            "age": "",
+            "skin_tone_and_texture": "",
+            "facial_features": ""
+        }],
+        "background_setting": "Solid color backdrop",
+        "lighting": {
+            "conditions": "Neutral",
+            "direction": "Uniform",
+            "shadows": "None",
+            "illumination_effect": "Even"
+        },
+        "aesthetics": {
+            "composition": "Centered",
+            "color_scheme": "Vibrant",
+            "mood_atmosphere": "Neutral",
+            "patterns": "Geometric"
+        },
+        "cinematography": {
+            "camera_motion": "Static",
+            "framing": "Wide shot",
+            "camera_angle": "Eye-level",
+            "depth_of_field": "Deep",
+            "focus": "Sharp",
+            "lens_focal_length": "35mm"
+        },
+        "actions": [{"description": "Displaying animated patterns"}],
+        "segments": [{"start_time": "0s", "end_time": duration_str, "description": "Full video segment"}],
+        "text_and_signage_elements": [],
+        "transitions": [],
+        "temporal_caption": caption_text,
+        "audio_description": ""
+    }
+
+    # Write caption.json
+    with open(caption_dir / "caption.json", "w") as f:
+        json.dump(caption_json, f, indent=2)
+
+    # JSONL entry
+    jsonl_entry = {
+        "uuid": uuid,
