 def _hf_download(cmd_args: list[str]) -> str:
-    """Run Hugging Face CLI download command and return the local path.
+    """Download checkpoint via ModelScope and return the local path.
 
-    Uses a newer Hugging Face CLI version to download checkpoint. The dependency
-    version is very old and not robust.
+    Parses the original Hugging Face CLI arguments and redirects to
+    ``modelscope.snapshot_download`` so no code changes are needed at
+    call-sites.
     """
+    # HF repo ID -> ModelScope repo ID mapping
+    _HF_TO_MS_REPO = {
+        "nvidia/Cosmos3-Nano": "nv-community/Cosmos3-Nano",
+        "nvidia/Cosmos3-Super": "nv-community/Cosmos3-Super",
+        "nvidia/Cosmos3-Nano-Reasoner": "nv-community/Cosmos3-Nano-Reasoner",
+        "nvidia/Cosmos3-Super-Reasoner": "nv-community/Cosmos3-Super-Reasoner",
+        "nvidia/Cosmos-Guardrail1": "nv-community/Cosmos-Guardrail1",
+    }
+
+    # Parse HF-style cmd_args: [repo, --repo-type, X, --revision, R, [--include P | filename] ...]
+    repository = cmd_args[0]
+    repository = _HF_TO_MS_REPO.get(repository, repository)
+    revision = "main"
+    patterns: list[str] = []
+    i = 1
+    while i < len(cmd_args):
+        if cmd_args[i] == "--revision" and i + 1 < len(cmd_args):
+            revision = cmd_args[i + 1]
+            i += 2
+        elif cmd_args[i] == "--include" and i + 1 < len(cmd_args):
+            patterns.append(cmd_args[i + 1])
+            i += 2
+        elif cmd_args[i] in ("--repo-type", "--format=json"):
+            i += 2 if cmd_args[i] == "--repo-type" else 1
+        else:
+            # Positional arg – treat as filename pattern
+            patterns.append(cmd_args[i])
