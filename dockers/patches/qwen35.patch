+
+    def test_present_dim(self):
+        grid = self._mock_grid([2, 4, 1, 3], ["tp", "dp", "pp", "cp"])
+        assert _get_dim_size(grid, "cp") == 3
+        assert _get_dim_size(grid, "tp") == 2
+
+    def test_absent_dim(self):
+        grid = self._mock_grid([2, 4], ["tp", "dp"])
+        assert _get_dim_size(grid, "cp") == 1
