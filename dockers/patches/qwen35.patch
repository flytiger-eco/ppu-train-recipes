+def _vision_forward_fixed_length_setup(
+    hidden_states: torch.Tensor,
+    rotary_pos_emb: torch.Tensor,
+    grid_thw: torch.Tensor,
+    deepstack_visual_indexes: list[int],
+) -> tuple[torch.Tensor, torch.Tensor, int, int]:
+    """Reshape vision tensors for fixed-length (non-varlen) Flash Attention.
+
+    When all frames have the same spatial size, we can treat each frame as a
+    separate batch element and use standard batched FA instead of the varlen
+    path, avoiding the ``cu_seqlens`` overhead.
+
+    Args:
+        hidden_states: ``[total_tokens, hidden_size]``.
+        rotary_pos_emb: ``[total_tokens, 1, 1, dim]``.
+        grid_thw: Grid sizes per image/frame.
+        deepstack_visual_indexes: Deepstack layer indexes (must be empty).
+
+    Returns:
+        Tuple of (reshaped hidden_states ``[tokens_per_frame, num_frames, H]``,
+        truncated rotary_pos_emb ``[tokens_per_frame, 1, 1, dim]``,
+        num_frames, tokens_per_frame).
+
+    Raises:
+        ValueError: If frames have different spatial sizes or deepstack is non-empty.
+    """
+    if deepstack_visual_indexes:
+        raise ValueError(
+            "MEGATRON_VISION_FIXED_LENGTH_ATTENTION is not compatible with "
+            "non-empty deepstack_visual_indexes. Disable the env var or use a "
+            "model without deepstack (e.g. Qwen3.5 VL)."
+        )
+
+    # Each frame has grid_thw[:, 1] * grid_thw[:, 2] tokens, repeated grid_thw[:, 0] times
+    tokens_per_frame_all = grid_thw[:, 1] * grid_thw[:, 2]
+    if not torch.all(tokens_per_frame_all == tokens_per_frame_all[0]):
+        raise ValueError(
+            f"MEGATRON_VISION_FIXED_LENGTH_ATTENTION requires all frames to have the "
+            f"same spatial size, but got varying sizes: {tokens_per_frame_all.tolist()}"
+        )
+
+    tokens_per_frame = tokens_per_frame_all[0].item()
+    num_frames = grid_thw[:, 0].sum().item()
+
+    hidden_states = hidden_states.reshape(num_frames, tokens_per_frame, -1).transpose(0, 1)
+    rotary_pos_emb = rotary_pos_emb[:tokens_per_frame]
+
+    return hidden_states, rotary_pos_emb, num_frames, tokens_per_frame
+
+
