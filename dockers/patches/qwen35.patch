+class TestDispatchCandidates:
+    def test_intranode_search_space(self):
+        candidates = _dispatch_candidates(is_internode=False)
+        assert all(len(c) == 1 for c in candidates)
+        assert candidates[0] == (4,)
+        assert candidates[-1] == (64,)
+        assert len(candidates) == 16
+
+    def test_internode_search_space(self):
+        candidates = _dispatch_candidates(is_internode=True)
+        assert all(len(c) == 2 for c in candidates)
+        assert (4, 4) in candidates
+        assert (44, 32) in candidates
+        nvl_values = sorted({c[0] for c in candidates})
+        rdma_values = sorted({c[1] for c in candidates})
+        assert nvl_values == list(range(4, 45, 4))
+        assert rdma_values == list(range(4, 33, 4))
