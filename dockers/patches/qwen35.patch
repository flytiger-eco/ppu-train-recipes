+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+"""Unit tests for CPAwareColocatedBridgeCommunicator logic.
+
+Tests cover the pure-logic helpers (rank position decomposition, gather group
+construction, validation) without requiring a distributed process group. The
+distributed forward/backward correctness tests live in the 3rdparty test suite
+under ``tests/unit_tests/models/mimo/test_mimo_colocated_communicator.py``.
+"""
+
+from unittest.mock import MagicMock, patch
+
+import pytest
+import torch
+
+from megatron.bridge.models.megatron_mimo.cp_aware_colocated_communicator import (
+    _compute_rank_positions,
+    _get_dim_size,
+)
+
+
+class TestComputeRankPositions:
+    """Verify coordinate decomposition for various grid shapes and dim orders."""
+
+    @staticmethod
+    def _mock_grid(shape, dim_names, rank_offset=0):
+        grid = MagicMock()
+        grid.shape = shape
+        grid.dim_names = dim_names
+        grid.rank_offset = rank_offset
+        grid.size = 1
+        for s in shape:
+            grid.size *= s
+        return grid
+
+    def test_4dim_tp_cp_dp_pp(self):
+        """4-dim grid [tp=2, cp=2, dp=2, pp=1] — the 3rdparty dim order."""
+        grid = self._mock_grid([2, 2, 2, 1], ["tp", "cp", "dp", "pp"])
+        pos = _compute_rank_positions(grid)
+        assert len(pos) == 8
+        assert pos[0] == (0, 0, 0)  # dp=0, cp=0, tp=0
+        assert pos[1] == (0, 0, 1)  # dp=0, cp=0, tp=1
+        assert pos[2] == (0, 1, 0)  # dp=0, cp=1, tp=0
+        assert pos[3] == (0, 1, 1)  # dp=0, cp=1, tp=1
+        assert pos[4] == (1, 0, 0)  # dp=1, cp=0, tp=0
+        assert pos[5] == (1, 0, 1)  # dp=1, cp=0, tp=1
+        assert pos[6] == (1, 1, 0)  # dp=1, cp=1, tp=0
+        assert pos[7] == (1, 1, 1)  # dp=1, cp=1, tp=1
+
+    def test_5dim_tp_cp_ep_pp_dp(self):
+        """5-dim grid [tp=2, cp=1, ep=1, pp=1, dp=4] — the bridge dim order."""
+        grid = self._mock_grid([2, 1, 1, 1, 4], ["tp", "cp", "ep", "pp", "dp"])
+        pos = _compute_rank_positions(grid)
+        assert len(pos) == 8
+        assert pos[0] == (0, 0, 0)  # dp=0, cp=0, tp=0
+        assert pos[1] == (0, 0, 1)  # dp=0, cp=0, tp=1
+        assert pos[2] == (1, 0, 0)  # dp=1, cp=0, tp=0
+        assert pos[3] == (1, 0, 1)
+        assert pos[4] == (2, 0, 0)
+        assert pos[5] == (2, 0, 1)
+        assert pos[6] == (3, 0, 0)
+        assert pos[7] == (3, 0, 1)
+
+    def test_5dim_with_cp2(self):
+        """5-dim grid [tp=2, cp=2, ep=1, pp=1, dp=2] — bridge dim order, CP=2."""
+        grid = self._mock_grid([2, 2, 1, 1, 2], ["tp", "cp", "ep", "pp", "dp"])
+        pos = _compute_rank_positions(grid)
+        assert len(pos) == 8
+        # tp varies fastest, then cp, then ep, then pp, then dp
+        assert pos[0] == (0, 0, 0)  # dp=0, cp=0, tp=0
+        assert pos[1] == (0, 0, 1)  # dp=0, cp=0, tp=1
+        assert pos[2] == (0, 1, 0)  # dp=0, cp=1, tp=0
+        assert pos[3] == (0, 1, 1)  # dp=0, cp=1, tp=1
+        assert pos[4] == (1, 0, 0)  # dp=1, cp=0, tp=0
+        assert pos[5] == (1, 0, 1)  # dp=1, cp=0, tp=1
+        assert pos[6] == (1, 1, 0)  # dp=1, cp=1, tp=0
+        assert pos[7] == (1, 1, 1)  # dp=1, cp=1, tp=1
+
+    def test_rank_offset(self):
+        """Grid starting at offset=4."""
+        grid = self._mock_grid([2, 1, 2, 1], ["tp", "cp", "dp", "pp"], rank_offset=4)
+        pos = _compute_rank_positions(grid)
+        assert set(pos.keys()) == {4, 5, 6, 7}
+        assert pos[4] == (0, 0, 0)
+        assert pos[5] == (0, 0, 1)
+        assert pos[6] == (1, 0, 0)
+        assert pos[7] == (1, 0, 1)
+
+    def test_no_cp_dim(self):
+        """Grid without a CP dimension defaults cp_idx to 0."""
+        grid = self._mock_grid([2, 4], ["tp", "dp"])
+        pos = _compute_rank_positions(grid)
+        assert len(pos) == 8
+        for rank, (dp, cp, tp) in pos.items():
+            assert cp == 0
+
+
+class TestBuildGatherGroupsCPAware:
+    """Test the per-CP-lane gather group construction."""
+
+    @staticmethod
+    def _import_build_gather_groups():
+        from megatron.bridge.models.megatron_mimo.cp_aware_colocated_communicator import (
+            CPAwareColocatedBridgeCommunicator,
+        )
+
+        return CPAwareColocatedBridgeCommunicator._build_gather_groups
+
+    def test_cp1_matches_base_fan_in(self):
+        """With CP=1 the groups should be identical to the base class behavior."""
+        build = self._import_build_gather_groups()
+        rank_to_pos = {
+            0: (0, 0, 0),
+            1: (0, 0, 1),
+            2: (1, 0, 0),
+            3: (1, 0, 1),
+            4: (2, 0, 0),
+            5: (2, 0, 1),
+            6: (3, 0, 0),
+            7: (3, 0, 1),
+        }
+        # FAN_IN: src tp=2, dp=4 → dest tp=4, dp=2. scale=2, iter_size=2, sibling_tp=2
+        groups = build(iter_size=2, sibling_tp_size=2, scale=2, rank_to_pos=rank_to_pos)
+        assert groups == [[0, 2], [1, 3], [4, 6], [5, 7]]
+
+    def test_cp2_creates_per_lane_groups(self):
+        """With CP=2 each CP lane gets independent gather groups."""
+        build = self._import_build_gather_groups()
+        # src: tp=1, cp=2, dp=4 → 8 ranks
+        rank_to_pos = {
+            0: (0, 0, 0),
+            1: (0, 1, 0),
+            2: (1, 0, 0),
+            3: (1, 1, 0),
+            4: (2, 0, 0),
+            5: (2, 1, 0),
+            6: (3, 0, 0),
+            7: (3, 1, 0),
+        }
+        # FAN_IN: dp=4 → dp=2, scale=2, tp=1
+        groups = build(iter_size=2, sibling_tp_size=1, scale=2, rank_to_pos=rank_to_pos)
+
+        # CP lane 0: [0,2], [4,6]
+        # CP lane 1: [1,3], [5,7]
+        assert groups == [[0, 2], [4, 6], [1, 3], [5, 7]]
+
+    def test_all_ranks_covered(self):
+        """Every rank must appear in exactly one gather group."""
+        build = self._import_build_gather_groups()
+        rank_to_pos = {
+            0: (0, 0, 0),
+            1: (0, 0, 1),
+            2: (0, 1, 0),
+            3: (0, 1, 1),
+            4: (1, 0, 0),
+            5: (1, 0, 1),
+            6: (1, 1, 0),
+            7: (1, 1, 1),
+        }
+        # EQUAL: dp=2 both sides, scale=1
+        groups = build(iter_size=2, sibling_tp_size=2, scale=1, rank_to_pos=rank_to_pos)
+
+        all_ranks = [r for g in groups for r in g]
+        assert sorted(all_ranks) == list(range(8))
+        assert len(all_ranks) == 8  # no duplicates
+
+    def test_src_cp1_dest_cp2_fan_in(self):
+        """src_cp=1, dest_cp=2 — gather groups use src positions, all ranks in cp=0."""
+        build = self._import_build_gather_groups()
+        # src: tp=1, cp=1, dp=8 → all ranks have cp=0
+        rank_to_pos = {i: (i, 0, 0) for i in range(8)}
+        # FAN_IN: dp=8 → dp=2, scale=4
+        groups = build(iter_size=2, sibling_tp_size=1, scale=4, rank_to_pos=rank_to_pos)
+
+        assert len(groups) == 2
+        assert groups == [[0, 1, 2, 3], [4, 5, 6, 7]]
+
+        all_ranks = [r for g in groups for r in g]
+        assert sorted(all_ranks) == list(range(8))
+
