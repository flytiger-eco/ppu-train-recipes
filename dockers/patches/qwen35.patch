+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+"""Unit tests for ModuleParallelismConfig EP/DP decoupling."""
+
+import pytest
+
+from megatron.bridge.models.megatron_mimo.megatron_mimo_config import (
+    ModuleParallelismConfig,
+)
+
+
+class TestModuleParallelismConfig:
+
+    def test_total_ranks_excludes_ep(self):
+        cfg = ModuleParallelismConfig(
+            tensor_model_parallel_size=2,
+            expert_model_parallel_size=16,
+            expert_tensor_parallel_size=1,
+            data_parallel_size=8,
+        )
+        assert cfg.total_ranks == 2 * 1 * 1 * 8  # tp * cp * pp * dp = 16
+
+    def test_total_model_parallel_size_excludes_ep(self):
+        cfg = ModuleParallelismConfig(
+            tensor_model_parallel_size=2,
+            context_parallel_size=2,
+            pipeline_model_parallel_size=2,
+            expert_model_parallel_size=16,
+        )
+        assert cfg.total_model_parallel_size == 2 * 2 * 2  # tp * cp * pp = 8
+
+    def test_expert_data_parallel_size(self):
+        cfg = ModuleParallelismConfig(
+            tensor_model_parallel_size=2,
+            expert_model_parallel_size=16,
+            expert_tensor_parallel_size=1,
+            data_parallel_size=8,
+        )
+        # total_ranks=16, expert_block = etp * ep * pp = 1 * 16 * 1 = 16
+        assert cfg.expert_data_parallel_size == 1
+
+    def test_expert_data_parallel_size_partial(self):
+        cfg = ModuleParallelismConfig(
+            tensor_model_parallel_size=2,
+            expert_model_parallel_size=4,
+            expert_tensor_parallel_size=1,
+            data_parallel_size=8,
+        )
+        # total_ranks=16, expert_block = 1 * 4 * 1 = 4
+        assert cfg.expert_data_parallel_size == 4
+
+    def test_resolved_expert_tp_defaults_to_tp(self):
+        cfg = ModuleParallelismConfig(
+            tensor_model_parallel_size=4,
+            expert_tensor_parallel_size=0,
+        )
+        assert cfg.resolved_expert_tensor_parallel_size == 4
+
+    def test_resolved_expert_tp_explicit(self):
+        cfg = ModuleParallelismConfig(
+            tensor_model_parallel_size=4,
+            expert_tensor_parallel_size=1,
+        )
+        assert cfg.resolved_expert_tensor_parallel_size == 1
+
+    def test_expert_dp_not_divisible_raises(self):
+        cfg = ModuleParallelismConfig(
+            tensor_model_parallel_size=2,
+            expert_model_parallel_size=3,
+            expert_tensor_parallel_size=1,
+            data_parallel_size=8,
+        )
+        # total_ranks=16, expert_block = 1 * 3 * 1 = 3, 16 % 3 != 0
+        with pytest.raises(ValueError, match="not divisible"):
+            _ = cfg.expert_data_parallel_size
+
+    def test_finalize_validates_expert_block(self):
+        cfg = ModuleParallelismConfig(
+            tensor_model_parallel_size=2,
+            expert_model_parallel_size=3,
+            expert_tensor_parallel_size=1,
+            data_parallel_size=8,
+        )
+        with pytest.raises(ValueError, match="not divisible"):
+            cfg.finalize(None)
+
+    def test_ep_1_backward_compatible(self):
+        cfg = ModuleParallelismConfig(
+            tensor_model_parallel_size=2,
+            pipeline_model_parallel_size=2,
+            data_parallel_size=2,
+        )
+        assert cfg.total_ranks == 2 * 2 * 2  # 8
+        assert cfg.expert_data_parallel_size == 8 // (2 * 1 * 2)  # etp=tp=2, ep=1, pp=2 → 2
+
+    def test_no_ep_field_defaults(self):
+        cfg = ModuleParallelismConfig(
+            tensor_model_parallel_size=4,
+            data_parallel_size=2,
+        )
+        assert cfg.expert_model_parallel_size == 1
+        assert cfg.expert_tensor_parallel_size == 0
+        assert cfg.resolved_expert_tensor_parallel_size == 4  # defaults to tp
