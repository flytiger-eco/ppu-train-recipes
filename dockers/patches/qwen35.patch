+    def _enable_vision_cpu_offloading(self, modality_specs: Dict[str, ModuleSpec]) -> None:
+        """Enable TE's native cpu_offloading on vision encoder TransformerConfigs.
+
+        This sets ``cpu_offloading=True`` on the ``TransformerConfig`` of each
+        vision encoder, so that ``TransformerBlock.__init__()`` creates a
+        ``DefaultOffloadSynchronizer`` via ``get_cpu_offload_context()``.
+
+        The TE offloading provides per-layer overlap:
+        - Layer N's D2H offload overlaps with layer N+1's forward compute
+        - Layer N's H2D reload overlaps with layer N+1's backward compute
+
+        This is handled entirely by the existing code in ``TransformerBlock.forward()``:
+
+        .. code-block:: python
+
+            with self.offload_context:
+                hidden_states, context = layer(...)
+            hidden_states = self.group_prefetch_offload_commit_async(hidden_states)
+
+        Notes:
+            - Activation recomputation is automatically disabled on the vision
+              encoder (``recompute_granularity=None``) because TE does not support
+              both cpu_offloading and recomputation simultaneously.
+            - At most ``num_layers - 1`` layers can be offloaded (TE requires
+              at least one layer to remain on GPU for the overlap schedule).
+            - Vision encoder PP is always 1 in MIMO, satisfying TE's constraint.
+        """
+        from megatron.core.transformer.transformer_config import TransformerConfig
+
+        for module_name, spec in modality_specs.items():
+            submodules = getattr(spec, "submodules", None) or {}
+            for encoder_name, encoder_spec in (submodules.get("encoders") or {}).items():
+                if encoder_spec.params is None:
+                    continue
+                config = encoder_spec.params.get("transformer_config")
+                if not isinstance(config, TransformerConfig):
+                    logger.debug(
+                        "Skipping cpu_offloading for encoder '%s.%s': config is not TransformerConfig (type=%s).",
+                        module_name, encoder_name, type(config).__name__,
+                    )
+                    continue
+                if not hasattr(config, "num_layers") or config.num_layers < 2:
+                    logger.warning(
+                        "Skipping cpu_offloading for encoder '%s.%s': "
+                        "num_layers=%s (need >= 2 for TE offloading schedule).",
+                        module_name, encoder_name,
+                        getattr(config, "num_layers", None),
+                    )
+                    continue
+
+                # Determine how many layers to offload.
+                max_offload = config.num_layers - 1
+                num_offload = self.vision_activation_offload_num_layers
+                if num_offload is None:
+                    num_offload = max_offload
+                elif num_offload > max_offload:
+                    logger.warning(
+                        "vision_activation_offload_num_layers=%d exceeds max=%d "
+                        "for encoder '%s.%s'. Clamping to %d.",
+                        num_offload, max_offload, module_name, encoder_name, max_offload,
+                    )
+                    num_offload = max_offload
+
+                # Disable activation recomputation — mutually exclusive with
+                # cpu_offloading in TE.
+                if config.recompute_granularity is not None:
+                    logger.info(
+                        "Disabling activation recomputation (recompute_granularity=%r) "
+                        "for encoder '%s.%s' because vision cpu_offloading is enabled.",
+                        config.recompute_granularity, module_name, encoder_name,
+                    )
+                    config.recompute_granularity = None
+
+                # Enable TE cpu_offloading.
+                config.cpu_offloading = True
+                config.cpu_offloading_num_layers = num_offload
+                config.cpu_offloading_activations = True
+                config.cpu_offloading_weights = False
