+class TestRecommendBufferTokens:
+    def test_small_cluster(self):
+        nvl, rdma = recommend_buffer_tokens(4)
+        assert nvl == 256
+        assert rdma == 128
+
+    def test_8_ranks(self):
+        nvl, rdma = recommend_buffer_tokens(8)
+        assert nvl == 256
+        assert rdma == 128
+
+    def test_medium_cluster(self):
+        nvl, rdma = recommend_buffer_tokens(32)
+        assert nvl == 288
+        assert rdma == 128
+
+    def test_64_ranks(self):
+        nvl, rdma = recommend_buffer_tokens(64)
+        assert nvl == 288
+        assert rdma == 128
+
+    def test_large_cluster(self):
+        nvl, rdma = recommend_buffer_tokens(128)
+        assert nvl == 560
+        assert rdma == 128
+
+    def test_very_large_cluster(self):
+        nvl, rdma = recommend_buffer_tokens(256)
+        assert nvl == 720
+        assert rdma == 128
+
+    def test_workload_aware_sizing(self):
+        nvl, rdma = recommend_buffer_tokens(16, num_tokens=4096, num_topk=8)
+        expected = (4096 * 8 + 15) // 16
+        assert nvl == expected
+        assert rdma == expected
+
+    def test_workload_aware_overrides_static(self):
+        nvl, rdma = recommend_buffer_tokens(8, num_tokens=4096, num_topk=8)
+        assert nvl > 256
+        assert rdma > 128
