+"""Bridge-layer MimoModel with CP-aware colocated communicators."""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Dict, Optional
+
+import torch
+import torch.distributed as dist
+from megatron.core.models.mimo.config.base_configs import MimoModelConfig
+from megatron.core.models.mimo.config.role import MIMO_LANGUAGE_MODULE_KEY
+from megatron.core.models.mimo.model.base import MimoModel
+
+from megatron.bridge.utils.common_utils import print_rank_0
+
+
+logger = logging.getLogger(__name__)
+
+
+class BridgeMimoModel(MimoModel):
+    """MimoModel that uses CP-aware colocated communicators.
+
+    The upstream ``MimoModel._build_colocated_communicators`` instantiates
+    ``ColocatedBridgeCommunicator`` which rejects CP > 1. This subclass
+    replaces that single method to use ``CPAwareColocatedBridgeCommunicator``
+    from the bridge layer, enabling context parallelism in colocated mode
+    without modifying the upstream code.
+    """
+
+    def __init__(self, mimo_config: MimoModelConfig, cp_group=None, tp_group=None) -> None:
+        """Initialize with rank-0 timing for each sub-step."""
+        is_rank0 = dist.is_initialized() and dist.get_rank() == 0
+        if is_rank0:
+            print_rank_0("[MIMO model] BridgeMimoModel.__init__ starting...")
+            self._init_t0 = time.monotonic()
+
+        super().__init__(mimo_config, cp_group=cp_group, tp_group=tp_group)
+
+        if is_rank0:
+            print_rank_0(f"[MIMO model] BridgeMimoModel.__init__ done in {time.monotonic() - self._init_t0:.1f}s")
+
+    def _initialize_submodules(self) -> None:
+        """Override to add timing around vision encoder construction."""
+        is_rank0 = dist.is_initialized() and dist.get_rank() == 0
+        if is_rank0:
+            print_rank_0("[MIMO model]   _initialize_submodules (vision encoders) starting...")
+        t0 = time.monotonic()
+        super()._initialize_submodules()
+        self._disable_cross_cp_for_submodule_gathered_comms()
+        if is_rank0:
+            print_rank_0(f"[MIMO model]   _initialize_submodules done in {time.monotonic() - t0:.1f}s")
+
+    def _initialize_language_model(self) -> None:
+        """Override to add timing around language model construction."""
+        is_rank0 = dist.is_initialized() and dist.get_rank() == 0
+        if is_rank0:
+            print_rank_0("[MIMO model]   _initialize_language_model starting...")
+        t0 = time.monotonic()
+        super()._initialize_language_model()
+        if is_rank0:
+            print_rank_0(f"[MIMO model]   _initialize_language_model done in {time.monotonic() - t0:.1f}s")
+
+    def _build_colocated_communicators(self) -> None:
+        from megatron.bridge.models.megatron_mimo.cp_aware_colocated_communicator import (
+            CPAwareColocatedBridgeCommunicator,
+        )
+
+        grid_map = self.mimo_config.module_to_grid_map
+        if any("tp" not in grid.dim_names or "dp" not in grid.dim_names for grid in grid_map.values()):
+            logger.info(
+                "Skipping colocated communicator setup because module_to_grid_map "
+                "does not define TP/DP topology for every module."
+            )
+            return
+
+        lang_key = MIMO_LANGUAGE_MODULE_KEY
+        lang_grid = grid_map[lang_key]
+        for mod_name in self.mimo_config.modality_submodules_spec:
+            if mod_name == lang_key:
+                continue
+            self.colocated_comms[(mod_name, lang_key)] = CPAwareColocatedBridgeCommunicator(
+                src_grid=grid_map[mod_name],
+                dest_grid=lang_grid,
+                src_module_name=mod_name,
+                dest_module_name=lang_key,
+                dim_mapping={"b": 0, "h": 1},
+            )
+
+    def _disable_cross_cp_for_submodule_gathered_comms(self) -> None:
+        """Disable cross-CP merge on communicators whose submodules handle CP gather."""
+        lang_key = MIMO_LANGUAGE_MODULE_KEY
+        for (mod_name, dest_name), comm in self.colocated_comms.items():
+            if dest_name != lang_key:
+                continue
+            submodule = self.modality_submodules[mod_name] if mod_name in self.modality_submodules else None
+            if submodule is not None and getattr(submodule, "handles_cp_gather", False):
+                if hasattr(comm, "_cross_cp"):
+                    comm._cross_cp = False
+                    logger.info(
+                        "Disabled cross-CP merge on communicator (%s, %s) — "
+                        "submodule handles CP gather internally.",
+                        mod_name,
+                        dest_name,
+                    )
+
+    def _forward_all_modules(
+        self,
+        input_ids: torch.Tensor,
+        position_ids: Optional[torch.Tensor],
+        attention_mask: Optional[torch.Tensor],
+        loss_mask: Optional[torch.Tensor],
+        labels: Optional[torch.Tensor],
+        modality_inputs: Optional[Dict[str, Dict[str, Any]]],
+        packing_kwargs: Optional[dict] = None,
+    ):
+        """Set local_batch_size on cross-CP communicators before the base forward."""
+        if self.colocated_comms:
+            for comm in self.colocated_comms.values():
+                if hasattr(comm, "_set_local_batch_size"):
+                    comm._set_local_batch_size(input_ids.size(0))
+
+        return super()._forward_all_modules(
+            input_ids, position_ids, attention_mask, loss_mask, labels, modality_inputs, packing_kwargs
+        )
