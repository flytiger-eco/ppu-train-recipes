+
+"""Auto-tuning utility for DeepEP dispatch/combine chunk sizes.
+
+This module benchmarks candidate NVL/RDMA chunk-size configurations on real
+hardware and patches ``deep_ep.Buffer`` to inject the optimal configs into
+every subsequent ``dispatch`` / ``combine`` call — without modifying
+``3rdparty/Megatron-LM``.
+
+The core entry point for programmatic use is :func:`enable_deepep_autotune`.
+For config-driven integration, :func:`maybe_run_deepep_autotune` is called
+from ``setup.py`` when ``moe_deepep_autotune = True``.
+
+Only the **public** surface of ``deep_ep`` is used:
+
+- ``deep_ep.Buffer`` attributes: ``group``, ``group_size``, ``rank``,
+  ``num_sms``, ``num_nvl_bytes``, ``num_rdma_bytes``,
+  ``runtime.get_num_rdma_ranks()``
+- ``deep_ep.Buffer`` methods: ``get_dispatch_layout``, ``dispatch``,
+  ``combine``, ``destroy``
+- ``deep_ep.Config``
+"""
+
+import inspect
+import logging
+from typing import Optional
+
+import torch
+import torch.distributed as dist
+
+
+logger: logging.Logger = logging.getLogger(__name__)
+logger.setLevel(logging.INFO)
+
+_DEEP_EP_AVAILABLE = False
+_DEEP_EP_CONFIG_SUPPORTED = False
+
+try:
+    from deep_ep import Buffer, Config
+
+    _DEEP_EP_AVAILABLE = True
+    _sig = inspect.signature(Buffer.dispatch)
+    _DEEP_EP_CONFIG_SUPPORTED = "config" in _sig.parameters
+except ImportError:
+    Buffer = None  # type: ignore[assignment, misc]
+    Config = None  # type: ignore[assignment, misc]
+
+
+# ---------------------------------------------------------------------------
+# Buffer sizing heuristics
+# ---------------------------------------------------------------------------
+
+
+def recommend_buffer_tokens(
+    num_ranks: int,
+    num_tokens: int = 0,
+    num_topk: int = 1,
+) -> tuple[int, int]:
+    """Return recv-buffer token counts ``(nvl_buf, rdma_buf)`` for the Config.
+
+    These values become ``num_max_*_chunked_recv_tokens`` in
+    ``deep_ep.Config``.  They must match the values used by
+    ``fused_a2a.get_buffer()`` so that Config hints fit the production
+    buffer allocation.
+
+    When *num_tokens* is provided the buffer is sized from the workload;
+    otherwise the static defaults matching DeepEP's built-in Config values
+    are returned (this is what ``auto_tune_deepep_config`` uses).
+    """
+    if num_tokens > 0:
+        tokens_per_rank = (num_tokens * num_topk + num_ranks - 1) // num_ranks
+        nvl_buf = tokens_per_rank
+        rdma_buf = tokens_per_rank
+        return nvl_buf, rdma_buf
+
+    if num_ranks <= 8:
+        nvl_buf = 256
+    elif num_ranks <= 64:
+        nvl_buf = 288
+    elif num_ranks <= 128:
+        nvl_buf = 560
+    else:
+        nvl_buf = 720
+    return nvl_buf, 128
+
+
+# ---------------------------------------------------------------------------
+# Config helpers
+# ---------------------------------------------------------------------------
+
+
+def _make_config(
+    num_sms: int,
+    is_internode: bool,
+    nvl_chunk: int,
+    nvl_buf: int,
+    rdma_chunk: int | None = None,
+    rdma_buf: int | None = None,
+) -> "Config":
+    """Build a ``deep_ep.Config``; RDMA fields are only meaningful for internode."""
+    if is_internode:
+        return Config(num_sms, nvl_chunk, nvl_buf, rdma_chunk, rdma_buf)
+    return Config(num_sms, nvl_chunk, nvl_buf)
+
+
+# ---------------------------------------------------------------------------
+# Candidate search spaces
+# ---------------------------------------------------------------------------
+
+
+def _dispatch_candidates(is_internode: bool) -> list[tuple[int, ...]]:
+    """Chunk-size search space for dispatch.
+
+    Ranges follow DeepEP's ``test_internode.py`` and ``test_intranode.py``.
+    """
+    if not is_internode:
+        return [(nvl,) for nvl in range(4, 65, 4)]
+    return [(nvl, rdma) for nvl in range(4, 45, 4) for rdma in range(4, 33, 4)]
+
+
+def _combine_candidates(is_internode: bool, num_rdma_ranks: int) -> list[tuple[int, ...]]:
+    """Chunk-size search space for combine.
+
+    Internode combine kernel requires ``rdma_send >= num_warps_per_forwarder``
+    (== 11 for 2 nodes), so the RDMA sweep starts high enough to stay valid.
+    """
+    if not is_internode:
+        return [(nvl,) for nvl in range(2, 33, 2)]
+    rdma_start = 12 if num_rdma_ranks == 2 else 8
+    return [(nvl, rdma) for nvl in range(1, 8, 1) for rdma in range(rdma_start, 33, 4)]
+
+
+# ---------------------------------------------------------------------------
+# Benchmarking
+# ---------------------------------------------------------------------------
+
+
+def _bench_candidate(
+    fn,
+    kwargs: dict,
+    *,
+    is_internode: bool,
+    num_iters: int,
+) -> float:
+    """Time a single candidate config and return average latency in ms.
+
+    Mirrors the benchmarking recipe used across DeepEP tests: barrier-align
+    all ranks, flush L2, then time *num_iters* runs and drop the first sample.
+    Warmup iterations are skipped in internode mode to avoid rank-progress
+    drift and spurious timeouts.
+    """
+    dist.all_reduce(torch.ones(1, dtype=torch.float, device="cuda"))
+    torch.cuda.synchronize()
+
+    cache = torch.empty(int(256e6 // 4), dtype=torch.int, device="cuda")
+
+    if not is_internode:
+        for _ in range(20):
+            fn(**kwargs)
+
+    cache.zero_()
+
+    start_events = [torch.cuda.Event(enable_timing=True) for _ in range(num_iters)]
+    end_events = [torch.cuda.Event(enable_timing=True) for _ in range(num_iters)]
+    for i in range(num_iters):
+        dist.all_reduce(torch.ones(1, dtype=torch.float, device="cuda"))
+        start_events[i].record()
+        fn(**kwargs)
+        end_events[i].record()
+    torch.cuda.synchronize()
+
+    times = torch.tensor([s.elapsed_time(e) for s, e in zip(start_events, end_events)])[1:]
+    return times.mean().item()
+
+
+def _broadcast_best_params(
+    params: tuple[int, ...],
+    group: dist.ProcessGroup,
+    group_size: int,
+) -> tuple[int, ...]:
+    """Broadcast rank 0's best params to every rank for a consistent choice."""
+    param_tensor = torch.tensor(list(params), dtype=torch.int32, device="cuda")
+    gathered = [torch.zeros_like(param_tensor) for _ in range(group_size)]
+    dist.all_gather(gathered, param_tensor, group=group)
+    return tuple(gathered[0].tolist())
+
+
+# ---------------------------------------------------------------------------
+# Core auto-tune
+# ---------------------------------------------------------------------------
+
+
+def auto_tune_deepep_config(
+    buffer: "Buffer",
+    hidden: int,
+    *,
+    num_tokens: int = 4096,
+    num_topk: int = 8,
+    num_experts: int | None = None,
+    num_iters: int = 20,
+    nvl_buffer_size = None,
+    rdma_buffer_size: Optional[int] = None
+) -> tuple["Config", "Config"]:
+    """Auto-tune the dispatch/combine ``Config`` for a DeepEP ``Buffer``.
+
+    A synthetic MoE routing workload is generated, then candidate chunk sizes
+    are benchmarked on real hardware.  Rank 0's winning parameters are broadcast
+    to all ranks so every rank agrees on the same config.
+
+    The approach follows ``deep_ep/tests/legacy/test_internode.py``:
+
+    - ``nvl_buf`` / ``rdma_buf`` (recv-token counts) are held fixed at the
+      values that ``fused_a2a.get_buffer()`` used to size the production
+      buffer (derived from ``Buffer.get_dispatch_config``).
+    - Only ``nvl_chunk`` and ``rdma_chunk`` (send chunk sizes) are swept.
+    - The production buffer is reused for benchmarking — no separate buffer
+      is allocated.
+
+    Args:
+        buffer: An initialized ``deep_ep.Buffer`` (intranode or internode).
+        hidden: Hidden dimension of each token.
+        num_tokens: Number of tokens in the synthetic workload.
+        num_topk: Top-k routing value.
+        num_experts: Total experts (default: ``group_size * 8``); auto-aligned
+            to a multiple of ``group_size``.
+        num_iters: Timed iterations per candidate.
+
+    Returns:
+        ``(dispatch_config, combine_config)`` — the best configs found.
+    """
+    group = buffer.group
+    group_size = buffer.group_size
+    rank = buffer.rank
+    num_sms = buffer.num_sms
+    # Detect internode exactly like Buffer.dispatch/combine do internally
+    # (number of RDMA ranks == number of nodes), rather than relying on any
+    # auto-tune-specific helper (e.g. `is_internode`) that no longer exists.
+    num_rdma_ranks = buffer.runtime.get_num_rdma_ranks()
+    is_internode = num_rdma_ranks > 1
+
+    if num_experts is None:
+        num_experts = group_size * 8
+    num_experts = (num_experts // group_size) * group_size
+
+    def_nvl, def_rdma = recommend_buffer_tokens(group_size)
+    nvl_buf = def_nvl if nvl_buffer_size is None else nvl_buffer_size
+    rdma_buf = def_rdma if rdma_buffer_size is None else rdma_buffer_size
+
+    def _log(msg: str) -> None:
+        # if rank == 0:
+        logger.info("[deepep_autotune] %s", msg)
+
+    _log(f'group_size={group_size}, num_rdma_ranks={num_rdma_ranks}, '
+        f'mode={"internode" if is_internode else "intranode"}, hidden={hidden}, '
+        f'num_tokens={num_tokens}, num_experts={num_experts}, num_iters={num_iters}')
+    # --- Synthetic routing workload ---
+    x = torch.randn(num_tokens, hidden, dtype=torch.bfloat16, device='cuda')
+    scores = torch.randn(num_tokens, num_experts, dtype=torch.float32, device='cuda').abs() + 1
+    topk_idx = torch.topk(scores, num_topk, dim=-1, largest=True, sorted=False)[1]
+
+    num_tokens_per_rank, num_tokens_per_rdma_rank, num_tokens_per_expert, is_token_in_rank, _ = \
+        buffer.get_dispatch_layout(topk_idx, num_experts)
+
+    # Non-cached dispatch once to obtain a reusable handle for cached-mode tuning.
+    dispatch_kwargs = {
+        'x': x, 'num_tokens_per_rank': num_tokens_per_rank,
+        'is_token_in_rank': is_token_in_rank,
+        'num_tokens_per_expert': num_tokens_per_expert,
+        'config': _make_config(num_sms, is_internode, 4, nvl_buf, 8, rdma_buf),
+    }
+    if is_internode:
+        dispatch_kwargs['num_tokens_per_rdma_rank'] = num_tokens_per_rdma_rank
+    recv_x, _, _, _, handle, _ = buffer.dispatch(**dispatch_kwargs)
+
+    bf16_nvl_bytes = recv_x.numel() * 2
+    bf16_rdma_bytes = num_tokens_per_rdma_rank.sum().item() * hidden * 2 if is_internode else 0
+
+    # === Tune dispatch (cached mode reuses the handle) ===
+    _log('Tuning dispatch config ...')
+    best_dispatch_time = float('inf')
+    best_dispatch_params = None
+    for params in _dispatch_candidates(is_internode):
+        cfg = _make_config(num_sms, is_internode, params[0], nvl_buf,
+                           params[1] if is_internode else None, rdma_buf if is_internode else None)
+        t = _bench_candidate(buffer.dispatch, {'x': x, 'handle': handle, 'config': cfg},
+                             is_internode=is_internode, num_iters=num_iters)
+        if t < best_dispatch_time:
+            best_dispatch_time, best_dispatch_params = t, params
+
+    best_dispatch_params = _broadcast_best_params(best_dispatch_params, group, group_size)
+    best_dispatch_config = _make_config(
+        num_sms, is_internode, best_dispatch_params[0], nvl_buf,
+        best_dispatch_params[1] if is_internode else None, rdma_buf if is_internode else None)
+
+    if is_internode:
+        _log(f'Best dispatch: nvl_chunk={best_dispatch_params[0]}, rdma_chunk={best_dispatch_params[1]}, '
+            f'time={best_dispatch_time:.3f} ms, '
+            f'{bf16_rdma_bytes / 1e9 / (best_dispatch_time / 1e3):.2f} GB/s (RDMA), '
+            f'{bf16_nvl_bytes / 1e6 / best_dispatch_time:.2f} GB/s (NVL)')
+    else:
+        _log(f'Best dispatch: nvl_chunk={best_dispatch_params[0]}, '
+            f'time={best_dispatch_time:.3f} ms, '
+            f'{bf16_nvl_bytes / 1e6 / best_dispatch_time:.2f} GB/s (NVL)')
+
+    # Re-dispatch with the best config to get a proper handle for combine tuning.
+    dispatch_kwargs['config'] = best_dispatch_config
+    recv_x, _, _, _, handle, _ = buffer.dispatch(**dispatch_kwargs)
+
+    # === Tune combine ===
+    _log('Tuning combine config ...')
+    best_combine_time = float('inf')
+    best_combine_params = None
+    for params in _combine_candidates(is_internode, num_rdma_ranks):
+        cfg = _make_config(num_sms, is_internode, params[0], nvl_buf,
+                           params[1] if is_internode else None, rdma_buf if is_internode else None)
+        t = _bench_candidate(buffer.combine, {'x': recv_x, 'handle': handle, 'config': cfg},
+                             is_internode=is_internode, num_iters=num_iters)
+        if t < best_combine_time:
+            best_combine_time, best_combine_params = t, params
+
+    best_combine_params = _broadcast_best_params(best_combine_params, group, group_size)
+    best_combine_config = _make_config(
+        num_sms, is_internode, best_combine_params[0], nvl_buf,
+        best_combine_params[1] if is_internode else None, rdma_buf if is_internode else None)
+
+    if is_internode:
+        _log(f'Best combine: nvl_chunk={best_combine_params[0]}, rdma_chunk={best_combine_params[1]}, '
+            f'time={best_combine_time:.3f} ms, '
+            f'{bf16_rdma_bytes / 1e9 / (best_combine_time / 1e3):.2f} GB/s (RDMA), '
+            f'{bf16_nvl_bytes / 1e6 / best_combine_time:.2f} GB/s (NVL)')
+    else:
+        _log(f'Best combine: nvl_chunk={best_combine_params[0]}, '
+            f'time={best_combine_time:.3f} ms, '
+            f'{bf16_nvl_bytes / 1e6 / best_combine_time:.2f} GB/s (NVL)')
+
+    _log('Auto-tune complete.')
+    return best_dispatch_config, best_combine_config
+
+
+# ---------------------------------------------------------------------------
+# Buffer class patching
+# ---------------------------------------------------------------------------
+
+_patched = False
+
+
+def _patch_buffer_class(dispatch_config: "Config", combine_config: "Config") -> None:
+    """Patch ``deep_ep.Buffer.dispatch`` and ``Buffer.combine`` at the class
+    level to inject auto-tuned configs into every call.
+
+    This is idempotent — calling it multiple times replaces the previous
+    tuned configs without stacking wrappers.
+    """
+    global _patched, _active_dispatch_config, _active_combine_config
+
+    if not _DEEP_EP_CONFIG_SUPPORTED:
+        logger.info(
+            "deep_ep.Buffer.dispatch does not accept a 'config' parameter. "
+            "Auto-tuned configs will NOT be injected. Upgrade deep_ep to a "
+            "version that supports the 'config' keyword argument."
+        )
+        return
+
+    if _patched:
+        _active_dispatch_config = dispatch_config
+        _active_combine_config = combine_config
+        return
+
+    _original_dispatch = Buffer.dispatch
+    _original_combine = Buffer.combine
+
+    _active_dispatch_config = dispatch_config
+    _active_combine_config = combine_config
+
+    def _patched_dispatch(self, *args, **kwargs):
+        if "config" not in kwargs and _active_dispatch_config is not None:
+            kwargs["config"] = _active_dispatch_config
+        return _original_dispatch(self, *args, **kwargs)
+
+    def _patched_combine(self, *args, **kwargs):
+        if "config" not in kwargs and _active_combine_config is not None:
+            kwargs["config"] = _active_combine_config
+        return _original_combine(self, *args, **kwargs)
+
+    Buffer.dispatch = _patched_dispatch
+    Buffer.combine = _patched_combine
+    _patched = True
+
+
+_active_dispatch_config: Optional["Config"] = None
+_active_combine_config: Optional["Config"] = None
+
+_autotune_pending: bool = False
+_autotune_params: dict = {}
+
+
+def _install_lazy_patch() -> None:
+    """Install a one-shot interceptor on ``Buffer.dispatch``.
+
+    The interceptor fires on the first real dispatch call, runs auto-tune
+    using the production buffer (already correctly sized by
+    ``fused_a2a.get_buffer``), then installs permanent config-injecting
+    patches.  This sidesteps buffer-sizing mismatches that occur when a
+    temporary buffer is created with byte allocations that do not match the
+    benchmark workload.
+    """
+    global _autotune_pending
+
+    if _autotune_pending:
+        return
+    _autotune_pending = True
+
+    _original_dispatch = Buffer.dispatch
+    _original_combine = Buffer.combine
+
+    def _lazy_dispatch(self, *args, **kwargs):
+        global _autotune_pending
+        if not _autotune_pending:
+            return _original_dispatch(self, *args, **kwargs)
+
+        _autotune_pending = False
+        Buffer.dispatch = _original_dispatch
+        Buffer.combine = _original_combine
+
+        p = _autotune_params
+        hidden_dim = p["hidden_dim"]
+        num_tokens = p["num_tokens"]
+        num_topk = p["num_topk"]
+        num_sms = p.get("num_sms", 20)
+
+        Buffer.set_num_sms(num_sms)
+
+        logger.warning(
+            "[deepep_autotune] _lazy_dispatch triggered on production buffer:\n"
+            "  group_size=%d, rank=%d, num_sms=%d\n"
+            "  buffer.num_nvl_bytes=%d, buffer.num_rdma_bytes=%d\n"
+            "  buffer.num_rdma_ranks=%d\n"
+            "  hidden_dim=%d, num_tokens=%d, num_topk=%d",
+            self.group_size,
+            self.rank,
+            num_sms,
+            self.num_nvl_bytes,
+            self.num_rdma_bytes,
+            self.runtime.get_num_rdma_ranks(),
+            hidden_dim,
+            num_tokens,
+            num_topk,
+        )
+
+        hidden_bytes = hidden_dim * 2  # bf16
+        expected_rdma_bytes = 0
+        for _cfg in (
+            Buffer.get_dispatch_config(self.group_size),
+            Buffer.get_combine_config(self.group_size),
+        ):
+            hint = _cfg.get_rdma_buffer_size_hint(hidden_bytes, self.group_size)
+            expected_rdma_bytes = max(hint, expected_rdma_bytes)
+            logger.warning(
+                "[deepep_autotune] Config hint: nvl=%d rdma=%d (group_size=%d, hidden_bytes=%d)",
+                _cfg.get_nvl_buffer_size_hint(hidden_bytes, self.group_size),
+                hint,
+                self.group_size,
+                hidden_bytes,
+            )
+        logger.warning(
+            "[deepep_autotune] RDMA diagnosis: expected=%d, actual=%d, match=%s",
+            expected_rdma_bytes,
+            self.num_rdma_bytes,
+            expected_rdma_bytes <= self.num_rdma_bytes,
+        )
+
+        if p.get("diagnose_only", False):
+            logger.warning("[deepep_autotune] diagnose_only=True, skipping auto-tune.")
+            return _original_dispatch(self, *args, **kwargs)
+
+        logger.info("[deepep_autotune] Running auto-tune on first dispatch ...")
+
+        dispatch_cfg, combine_cfg = auto_tune_deepep_config(
+            self,
+            hidden_dim,
+            num_tokens=num_tokens,
+            num_topk=num_topk,
+            num_experts=p["num_experts"],
+            num_iters=p["num_iters"],
+        )
+
+        _patch_buffer_class(dispatch_cfg, combine_cfg)
+
+        return Buffer.dispatch(self, *args, **kwargs)
+
+    Buffer.dispatch = _lazy_dispatch
+
+
+# ---------------------------------------------------------------------------
+# Public entry point
+# ---------------------------------------------------------------------------
+
+
+def enable_deepep_autotune(
+    hidden_dim: int,
+    *,
+    num_tokens: int = 4096,
+    num_topk: int = 8,
+    num_experts: int | None = None,
+    num_iters: int = 20,
+    num_sms: int = 20,
+    diagnose_only: bool = False,
+) -> None:
+    """Arm lazy auto-tuning of DeepEP dispatch/combine chunk sizes.
+
+    Instead of creating a temporary buffer and benchmarking immediately, this
+    installs a one-shot interceptor on ``Buffer.dispatch``.  The benchmark
+    runs on the first real dispatch call using the production buffer (already
+    correctly sized by ``fused_a2a.get_buffer()``), eliminating buffer-sizing
+    mismatches.
+
+    After the benchmark completes, ``Buffer.dispatch`` and ``Buffer.combine``
+    are permanently patched to inject the optimal configs into every call.
+
+    This function is safe to call from any rank; all ranks participate in the
+    benchmark and rank 0's results are broadcast to ensure consistency.
+
+    Args:
+        hidden_dim: Hidden dimension of the model.
+        num_tokens: Number of tokens for the synthetic benchmark workload.
+        num_topk: Top-k routing value.
+        num_experts: Total number of experts.
+        num_iters: Timed iterations per candidate.
+        num_sms: Number of SMs for DeepEP.
+    """
+    if not _DEEP_EP_AVAILABLE:
+        raise ImportError(
+            "deep_ep is not installed. Install it from https://github.com/deepseek-ai/deepep to use auto-tuning."
+        )
+
+    if not _DEEP_EP_CONFIG_SUPPORTED:
+        raise RuntimeError(
+            "The installed version of deep_ep does not support the 'config' "
+            "parameter in Buffer.dispatch(). Upgrade deep_ep to use auto-tuning."
+        )
+
+    global _autotune_params
+    _autotune_params = {
+        "hidden_dim": hidden_dim,
+        "num_tokens": num_tokens,
+        "num_topk": num_topk,
+        "num_experts": num_experts,
+        "num_iters": num_iters,
+        "num_sms": num_sms,
+        "diagnose_only": diagnose_only,
+    }
+    _install_lazy_patch()
+    logger.info("[deepep_autotune] Auto-tune armed (lazy); will benchmark on first dispatch call.")
+
+
+# ---------------------------------------------------------------------------
+# Config-driven integration (called from setup.py)
+# ---------------------------------------------------------------------------
+
+
+def maybe_run_deepep_autotune(
+    transformer_config,
+    model: list,
+) -> None:
+    """Arm lazy DeepEP auto-tune if enabled in the transformer config.
+
+    Called from ``setup.py`` after ``_build_distributed_model()``.  The actual
+    benchmark runs lazily on the first ``Buffer.dispatch()`` call using the
+    production buffer.
+
+    Args:
+        transformer_config: The ``TransformerConfig`` (Bridge or MCore).
+        model: The list of model chunks (unused in lazy mode, kept for API
+            compatibility).
+    """
+    if not getattr(transformer_config, "moe_deepep_autotune", False):
+        return
+
+    if not _DEEP_EP_AVAILABLE:
+        logger.info("moe_deepep_autotune is True but deep_ep is not installed. Skipping auto-tune.")
+        return
+
+    if not _DEEP_EP_CONFIG_SUPPORTED:
+        logger.info(
+            "deep_ep does not support the 'config' parameter in Buffer.dispatch(). "
+            "Upgrade deep_ep to use auto-tuning. Skipping auto-tune."
+        )
+        return
+
+    if getattr(transformer_config, "moe_token_dispatcher_type", None) != "flex":
+        logger.info(
+            "moe_deepep_autotune requires moe_token_dispatcher_type='flex'. Current: %s. Skipping auto-tune.",
+            getattr(transformer_config, "moe_token_dispatcher_type", None),
+        )
+        return
+
+    if getattr(transformer_config, "moe_flex_dispatcher_backend", None) != "deepep":
+        logger.info(
+            "moe_deepep_autotune requires moe_flex_dispatcher_backend='deepep'. Current: %s. Skipping auto-tune.",
+            getattr(transformer_config, "moe_flex_dispatcher_backend", None),
+        )
+        return
+
+    hidden_dim = transformer_config.hidden_size
+    num_experts = getattr(transformer_config, "num_moe_experts", None)
+    num_topk = getattr(transformer_config, "moe_router_topk", 8)
+    num_sms = getattr(transformer_config, "moe_deepep_num_sms", 20)
+    num_tokens = getattr(transformer_config, "moe_deepep_autotune_num_tokens", 4096)
+    num_iters = getattr(transformer_config, "moe_deepep_autotune_num_iters", 20)
+
+    diagnose_only = getattr(transformer_config, "moe_deepep_autotune_diagnose_only", False)
+
+    enable_deepep_autotune(
+        hidden_dim=hidden_dim,
+        num_tokens=num_tokens,
+        num_topk=num_topk,
+        num_experts=num_experts,
+        num_iters=num_iters,
+        num_sms=num_sms,
+        diagnose_only=diagnose_only,
+    )
+
+
+def _extract_ep_group(model: list) -> Optional[dist.ProcessGroup]:
+    """Walk the model to find the EP process group from the first MoE layer."""
+    from megatron.core.transformer.moe.moe_layer import MoELayer
+
+    unwrapped = model[0]
+    while hasattr(unwrapped, "module"):
+        unwrapped = unwrapped.module
+
+    for module in unwrapped.modules():
+        if isinstance(module, MoELayer):
+            dispatcher = getattr(module, "token_dispatcher", None)
+            if dispatcher is None:
+                continue
+            comm_manager = getattr(dispatcher, "_comm_manager", None)
+            if comm_manager is not None:
+                return getattr(comm_manager, "group", None)
+    return None
