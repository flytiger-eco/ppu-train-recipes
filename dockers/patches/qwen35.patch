+"""CP-aware colocated bridge communicator.
+
+Extends ``ColocatedBridgeCommunicator`` to support context parallelism (CP > 1)
+by using coordinate decomposition for rank mappings and per-CP-lane gather groups.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections import defaultdict
+from typing import Dict, List, Optional, Tuple
+
+import torch
+import torch.distributed as dist
+from megatron.core.hyper_comm_grid import HyperCommGrid
+from megatron.core.models.mimo.comm.colocated_communicator import (
+    ColocatedBridgeCommunicator,
+    _all_gather_along_batch_dim,
+)
+
+
+logger = logging.getLogger(__name__)
+
+
+class CPAwareColocatedBridgeCommunicator(ColocatedBridgeCommunicator):
+    """Colocated bridge communicator that supports context parallelism.
+
+    The upstream ``ColocatedBridgeCommunicator`` restricts CP to 1 because its
+    rank mapping uses ``get_rank_enum(['tp'])`` which conflates CP indices with
+    DP indices when CP > 1. This subclass fixes the issue by:
+
+    1. Decomposing ranks into ``(dp, cp, tp)`` coordinates via the grid shape
+       instead of relying on ``get_rank_enum``.
+    2. Building per-CP-lane gather groups so that all_gather never mixes data
+       from different CP indices.
+    3. Relaxing the validation to allow CP > 1 while keeping PP = 1.
+
+    Supported CP configurations:
+
+    - ``src_cp = 1, dest_cp >= 1``: primary VLM case (encoder has no CP).
+    - ``src_cp = dest_cp > 1``: per-CP-lane DP redistribution.
+    - ``src_cp != dest_cp`` with both > 1: cross-CP redistribution via
+      all-gather + reshape. Requires one CP value to divide the other.
+    """
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+
+        self._cross_cp = self.src_cp_size > 1 and self.dest_cp_size > 1 and self.src_cp_size != self.dest_cp_size
+        self._cp_merge_pg: Optional[dist.ProcessGroup] = None
+        self._local_batch_size: Optional[int] = None
+
+        if self._cross_cp:
+            cp_merge_groups = self._build_cp_merge_groups()
+            self._cp_merge_pg, _ = dist.new_subgroups_by_enumeration(cp_merge_groups, backend="nccl")
+            self._src_cp_rank = self.rank_to_src_pos[self.current_rank][1]
+
+            logger.info(
+                f"[Rank {self.current_rank}] Cross-CP merge enabled: "
+                f"src_cp={self.src_cp_size}, dest_cp={self.dest_cp_size}, "
+                f"cp_merge_groups={cp_merge_groups}"
+            )
+
+    def _validate_grids(self) -> None:
+        if self.src_grid.size != self.dest_grid.size:
+            raise ValueError(
+                f"Grids must span same number of ranks: src={self.src_grid.size}, dest={self.dest_grid.size}"
+            )
+
+        if self.src_grid.rank_offset != self.dest_grid.rank_offset:
+            raise ValueError(
+                f"Grids must have same rank offset: src={self.src_grid.rank_offset}, dest={self.dest_grid.rank_offset}"
+            )
+
+        for name, grid in [("src", self.src_grid), ("dest", self.dest_grid)]:
+            for required in ("tp", "dp"):
+                if required not in grid.dim_names:
+                    raise ValueError(f"{name} grid must have '{required}' dimension, got dim_names={grid.dim_names}")
+            if "pp" in grid.dim_names:
+                pp_size = grid.shape[grid.dim_names.index("pp")]
+                if pp_size != 1:
+                    raise ValueError(f"{name} PP must be 1 for ColocatedBridgeCommunicator, got {pp_size}")
+
+        src_cp = _get_dim_size(self.src_grid, "cp")
+        dest_cp = _get_dim_size(self.dest_grid, "cp")
+        if src_cp > 1 and dest_cp > 1 and src_cp != dest_cp:
+            if src_cp % dest_cp != 0 and dest_cp % src_cp != 0:
+                raise ValueError(
+                    f"When both src and dest have CP > 1 they must be divisible: "
+                    f"src_cp={src_cp}, dest_cp={dest_cp}. "
+                    f"One must divide the other for cross-CP redistribution."
+                )
+
+        src_dp = self.src_grid.shape[self.src_grid.dim_names.index("dp")]
+        dest_dp = self.dest_grid.shape[self.dest_grid.dim_names.index("dp")]
+        if src_dp % dest_dp != 0 and dest_dp % src_dp != 0:
+            raise ValueError(f"DP sizes must be evenly divisible: src_dp={src_dp}, dest_dp={dest_dp}")
+
+    def _extract_parallelism_info(self) -> None:
+        super()._extract_parallelism_info()
+        self.src_cp_size = _get_dim_size(self.src_grid, "cp")
+        self.dest_cp_size = _get_dim_size(self.dest_grid, "cp")
+
+    def _build_rank_mappings(self) -> None:
+        self.rank_to_src_pos: Dict[int, Tuple[int, int, int]] = _compute_rank_positions(self.src_grid)
+        self.rank_to_dest_pos: Dict[int, Tuple[int, int, int]] = _compute_rank_positions(self.dest_grid)
+
+    @staticmethod
+    def _build_gather_groups(
+        iter_size: int,
+        sibling_tp_size: int,
+        scale: int,
+        rank_to_pos: Dict[int, Tuple[int, int, int]],
+    ) -> List[List[int]]:
+        """Build gather groups with one independent set per CP lane.
+
+        Within each CP lane the logic is identical to the base class: for each
+        slot on the iterating side and each TP shard on the sibling side,
+        collect the ``scale`` sibling ranks whose DP indices map into that slot.
+        """
+        cp_values = sorted({pos[1] for pos in rank_to_pos.values()})
+        groups: List[List[int]] = []
+        for cp_idx in cp_values:
+            for iter_idx in range(iter_size):
+                sibling_dp_indices = range(iter_idx * scale, (iter_idx + 1) * scale)
+                for sibling_tp_idx in range(sibling_tp_size):
+                    group_ranks: List[int] = []
+                    for sibling_dp_idx in sibling_dp_indices:
+                        for rank, (dp, cp, tp) in rank_to_pos.items():
+                            if dp == sibling_dp_idx and cp == cp_idx and tp == sibling_tp_idx:
+                                group_ranks.append(rank)
+                                break
+                    groups.append(group_ranks)
+        return groups
+
+    def _build_cp_merge_groups(self) -> List[List[int]]:
+        """Build groups for all-gather across src CP lanes within each (DP, TP) cell."""
+        cells: Dict[Tuple[int, int], List[Tuple[int, int]]] = defaultdict(list)
+        for rank, (dp, cp, tp) in self.rank_to_src_pos.items():
+            cells[(dp, tp)].append((cp, rank))
+
+        groups: List[List[int]] = []
+        for key in sorted(cells.keys()):
+            group_ranks = [rank for _, rank in sorted(cells[key])]
+            groups.append(group_ranks)
+        return groups
+
+    def _set_local_batch_size(self, dest_local_batch_size: int) -> None:
+        """Derive and store the src-side local batch size for CP merge reshape."""
+        if not self._cross_cp:
+            return
+        self._local_batch_size = dest_local_batch_size * self.dest_dp_size // self.src_dp_size
+
+    def communicate(self, tensor: torch.Tensor) -> torch.Tensor:
+        """Transform tensor from src TP/DP/CP layout to dest TP/DP layout.
+
+        When cross-CP is active, applies CP merge + reshape before
+        the standard DP redistribution.
+        """
+        if self._cross_cp:
+            assert self._local_batch_size is not None, (
+                "local_batch_size must be set via _set_local_batch_size() before communicate() when cross-CP is active"
+            )
+            tensor = _CrossCPMerge.apply(
+                tensor,
+                self._cp_merge_pg,
+                self.src_cp_size,
+                self._src_cp_rank,
+                self._local_batch_size,
+            )
+        return super().communicate(tensor)
+
+    def destroy(self) -> None:
+        """Release all process groups owned by this communicator."""
+        if self._cp_merge_pg is not None:
+            dist.destroy_process_group(self._cp_merge_pg)
+            self._cp_merge_pg = None
+        super().destroy()
+
+
+class _CrossCPMerge(torch.autograd.Function):
+    """All-gather across CP lanes and reshape from CP-major to sample-major.
+
+    Forward: gather tokens from all ``src_cp`` lanes, then reorder so tokens
+    are grouped by sample rather than by CP index.
+
+    Backward: inverse reshape (sample-major → CP-major) then narrow to this
+    rank's CP slice (the adjoint of all-gather).
+    """
+
+    @staticmethod
+    def forward(
+        ctx,
+        tensor: torch.Tensor,
+        cp_merge_pg: dist.ProcessGroup,
+        src_cp: int,
+        cp_rank: int,
+        local_batch_size: int,
+    ) -> torch.Tensor:
+        per_cp_tokens = tensor.size(0)
+        tokens_per_sample_per_cp = per_cp_tokens // local_batch_size
+        H = tensor.size(1)
+
+        assert per_cp_tokens % local_batch_size == 0, (
+            f"Tensor batch dim {per_cp_tokens} must be divisible by "
+            f"local_batch_size {local_batch_size} for cross-CP reshape"
+        )
+
+        ctx.cp_merge_pg = cp_merge_pg
+        ctx.src_cp = src_cp
+        ctx.cp_rank = cp_rank
+        ctx.local_batch_size = local_batch_size
+        ctx.per_cp_tokens = per_cp_tokens
+
+        gathered = _all_gather_along_batch_dim(tensor, cp_merge_pg, 0)
+
+        return (
+            gathered.view(src_cp, local_batch_size, tokens_per_sample_per_cp, H)
+            .permute(1, 0, 2, 3)
+            .reshape(local_batch_size * src_cp * tokens_per_sample_per_cp, H)
+            .contiguous()
+        )
+
+    @staticmethod
+    def backward(ctx, grad_output: torch.Tensor):
+        H = grad_output.size(1)
+        tokens_per_sample_per_cp = ctx.per_cp_tokens // ctx.local_batch_size
+
+        reordered = (
+            grad_output.view(ctx.local_batch_size, ctx.src_cp, tokens_per_sample_per_cp, H)
+            .permute(1, 0, 2, 3)
+            .reshape(ctx.src_cp * ctx.per_cp_tokens, H)
+            .contiguous()
+        )
+
+        grad_input = reordered.narrow(0, ctx.cp_rank * ctx.per_cp_tokens, ctx.per_cp_tokens).contiguous()
+
+        return grad_input, None, None, None, None
+
+
+def _get_dim_size(grid: HyperCommGrid, dim_name: str) -> int:
+    """Return the size of *dim_name* in *grid*, defaulting to 1 if absent."""
+    if dim_name not in grid.dim_names:
+        return 1
+    return grid.shape[grid.dim_names.index(dim_name)]
+
+
+def _compute_rank_positions(grid: HyperCommGrid) -> Dict[int, Tuple[int, int, int]]:
+    """Decompose every rank into ``(dp_idx, cp_idx, tp_idx)`` via the grid shape.
+
+    Works with any number of dimensions and any ordering of ``dim_names``
+    (e.g. 4-dim ``[tp, cp, dp, pp]`` or 5-dim ``[tp, cp, ep, pp, dp]``).
+    """
+    positions: Dict[int, Tuple[int, int, int]] = {}
+    for rank in range(grid.rank_offset, grid.rank_offset + grid.size):
+        temp = rank - grid.rank_offset
+        coords: Dict[str, int] = {}
+        for dim_name, size in zip(grid.dim_names, grid.shape):
+            coords[dim_name] = temp % size
+            temp //= size
+        positions[rank] = (coords["dp"], coords.get("cp", 0), coords["tp"])
+    return positions
