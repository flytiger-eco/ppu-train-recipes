+"""Vision modality submodules with CP-as-DP splitting for MIMO mode."""
+
+from __future__ import annotations
+
+import logging
+from typing import Dict, List, Optional
+
+import torch
+import torch.nn as nn
+from megatron.core.models.mimo.submodules.vision import VisionModalitySubmodules
+
+from megatron.bridge.models.qwen_vl.modelling_qwen3_vl.utils import (
+    AllGatherVisionEmbeddings,
+    collapse_thw,
+    get_vision_cp_data,
+    qwen3vl_cp_split,
+)
+
+
+logger = logging.getLogger(__name__)
+
+
+class Qwen3VLCPVisionSubmodules(VisionModalitySubmodules):
+    """Vision submodules that split images across CP ranks (vision DP-when-CP).
+
+    When ``vision_dp_when_cp`` is enabled and CP > 1, each CP rank encodes
+    only its share of images, then AllGathers the full embeddings. This
+    mirrors the ``vision_dp_when_cp`` logic in ``Qwen3VLModel.forward()``
+    but injected into the MIMO submodule path where the full-model forward
+    is not called.
+    """
+
+    def __init__(
+        self,
+        encoders: Optional[Dict[str, nn.Module]] = None,
+        decoders: Optional[Dict[str, nn.Module]] = None,
+        input_projections: Optional[List[nn.Module]] = None,
+        output_projections: Optional[List[nn.Module]] = None,
+        vision_dp_when_cp: bool = False,
+        **kwargs,
+    ):
+        """Initialize with vision_dp_when_cp flag."""
+        super().__init__(
+            encoders=encoders,
+            decoders=decoders,
+            input_projections=input_projections,
+            output_projections=output_projections,
+            **kwargs,
+        )
+        self.vision_dp_when_cp = vision_dp_when_cp
+
+    @property
+    def handles_cp_gather(self) -> bool:
+        """Whether this submodule handles CP gathering internally."""
+        if not self.vision_dp_when_cp:
+            return False
+        for encoder in self.encoders.values():
+            pg = getattr(encoder, "pg_collection", None)
+            if pg is not None:
+                cp_group = getattr(pg, "cp", None)
+                if cp_group is not None and torch.distributed.get_world_size(group=cp_group) > 1:
+                    return True
+        return False
+
+    def encode(self, encoders_data_batch: Dict) -> List[torch.Tensor]:
+        """Encode with CP splitting when vision_dp_when_cp is active."""
+        if not encoders_data_batch:
+            return []
+
+        if not self.vision_dp_when_cp:
+            return super().encode(encoders_data_batch)
+
+        embeddings = []
+
+        for name, encoder in self.encoders.items():
+            if name not in encoders_data_batch:
+                raise ValueError(f"No inputs found for encoder '{name}'")
+
+            pg = getattr(encoder, "pg_collection", None)
+            cp_group = getattr(pg, "cp", None) if pg is not None else None
+            cp_size = torch.distributed.get_world_size(group=cp_group) if cp_group is not None else 1
+
+            if cp_size <= 1:
+                encoder_outputs = self._run_encoder(encoder, encoders_data_batch[name])
+                embeddings.append(encoder_outputs)
+                continue
+
+            cp_rank = torch.distributed.get_rank(group=cp_group)
+            encoder_inputs = encoders_data_batch[name]
+            hidden_states = encoder_inputs["hidden_states"]
+            grid_thw = encoder_inputs["grid_thw"]
+
+            pixel_values, grid_thw_expanded, cp_img_num, images_padded = qwen3vl_cp_split(
+                cp_size, hidden_states, grid_thw
+            )
+
+            spatial_merge_size = encoder.spatial_merge_size
+            square_merge_size = spatial_merge_size**2
+
+            my_pixels, my_thw, seqlen_on_cp_ranks = get_vision_cp_data(
+                pixel_values, grid_thw_expanded, square_merge_size, cp_img_num, images_padded, cp_rank, cp_size
+            )
+
+            my_thw = collapse_thw(my_thw)
+
+            if my_pixels.size(0) == 0:
+                hidden_dim = encoder.config.out_hidden_size if hasattr(encoder, "config") else hidden_states.size(-1)
+                partial_embeds = torch.zeros(0, hidden_dim, device=hidden_states.device, dtype=hidden_states.dtype)
+            else:
+                partial_inputs = {**encoder_inputs, "hidden_states": my_pixels, "grid_thw": my_thw}
+                partial_embeds = self._run_encoder(encoder, partial_inputs)
+
+            full_embeds = AllGatherVisionEmbeddings.apply(partial_embeds, seqlen_on_cp_ranks, cp_group)
+
+            logger.debug(
+                "CP vision split: rank=%d, partial=%d, full=%d",
+                cp_rank,
+                partial_embeds.size(0),
+                full_embeds.size(0),
+            )
+
+            embeddings.append(full_embeds)
+
+        return embeddings
+
+    @staticmethod
+    def _run_encoder(encoder: nn.Module, encoder_inputs: dict) -> torch.Tensor:
+        """Run an encoder and flatten output to 2D."""
+        encoder_outputs = encoder(**encoder_inputs)
+        if isinstance(encoder_outputs, tuple) and encoder_outputs and torch.is_tensor(encoder_outputs[0]):
+            encoder_outputs = encoder_outputs[0]
+        if encoder_outputs.ndim == 3:
+            encoder_outputs = encoder_outputs.reshape(-1, encoder_outputs.size(-1))
+        return encoder_outputs
