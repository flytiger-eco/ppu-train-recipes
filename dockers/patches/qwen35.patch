+"""Fixed-length mock VLM dataset for performance benchmarking.
+
+This module provides a processor-free-at-runtime dataset that generates
+pre-computed, identical, fixed-length token sequences. The HF processor is
+used **once at init** to auto-detect image parameters (pixel shape, tokens
+per image, grid metadata). All subsequent iterations return the same
+pre-computed tensors with zero data-processing overhead.
+
+Supports both the VLM pipeline (``vlm_step.py`` / ``GenericVisualInputs``)
+and the MIMO pipeline (``megatron_mimo_step.py`` / ``modality_inputs`` dict)
+via the ``output_format`` flag.
+"""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass
+from typing import Any, Dict, List, Literal, Optional, Tuple
+
+import torch
+from torch.utils.data import Dataset
+
+from megatron.bridge.models.hf_pretrained.utils import is_safe_repo
+from megatron.bridge.training.config import DatasetBuildContext, DatasetProvider
+from megatron.bridge.training.utils.visual_inputs import GenericVisualInputs
+
+
+logger = logging.getLogger(__name__)
+
+IGNORE_INDEX = -100
+
+
+@dataclass
+class _ImageParams:
+    """Auto-detected image parameters from a single processor probe."""
+
+    image_token_id: int
+    tokens_per_image: int
+    pixel_values_per_image: torch.Tensor
+    image_grid_thw_per_image: torch.Tensor
+    vocab_size: int
+
+
+def _detect_image_params(
+    processor: Any,
+    image_size: Tuple[int, int],
+    vocab_size_override: int | None,
+    image_token_id_override: int | None,
+) -> _ImageParams:
+    """Probe the HF processor once to learn image shapes and token layout."""
+    from PIL import Image
+
+    dummy_image = Image.new("RGB", image_size)
+    messages = [
+        {
+            "role": "user",
+            "content": [
+                {"type": "image", "image": dummy_image},
+                {"type": "text", "text": "x"},
+            ],
+        },
+    ]
+    text = processor.apply_chat_template(messages, tokenize=False, add_generation_prompt=False)
+    inputs = processor(text=[text], images=[dummy_image], return_tensors="pt")
+
+    if image_token_id_override is not None:
+        image_token_id = image_token_id_override
+    else:
+        image_token_attr = getattr(processor, "image_token", None)
+        if image_token_attr is not None:
+            image_token_id = processor.tokenizer.convert_tokens_to_ids(image_token_attr)
+        else:
+            raise ValueError(
+                "Cannot auto-detect image_token_id: processor has no 'image_token' attribute. "
+                "Please set image_token_id explicitly."
+            )
+
+    input_ids = inputs.input_ids[0]
+    tokens_per_image = int((input_ids == image_token_id).sum().item())
+    if tokens_per_image == 0:
+        raise ValueError(
+            f"Processor probe found 0 image tokens with image_token_id={image_token_id}. "
+            f"Check that image_token_id is correct for this processor."
+        )
+
+    pixel_values = inputs.pixel_values
+    image_grid_thw = getattr(inputs, "image_grid_thw", None)
+    if image_grid_thw is None:
+        image_grid_thw_single = torch.tensor([1, 1, 1])
+    else:
+        # Flatten batch dims: [B, N, 3] -> [B*N, 3] -> take first row [3]
+        # or [N, 3] -> take first row [3]
+        if image_grid_thw.dim() == 3:
+            image_grid_thw = image_grid_thw.view(-1, 3)
+        image_grid_thw_single = image_grid_thw[0]  # [3]
+
+    if vocab_size_override is not None:
+        vocab_size = vocab_size_override
+    else:
+        vocab_size = getattr(processor.tokenizer, "vocab_size", None)
+        if vocab_size is None or vocab_size <= 1:
+            vocab_size = len(processor.tokenizer.get_vocab())
+
+    return _ImageParams(
+        image_token_id=image_token_id,
+        tokens_per_image=tokens_per_image,
+        pixel_values_per_image=pixel_values,
+        image_grid_thw_per_image=image_grid_thw_single,
+        vocab_size=vocab_size,
+    )
+
+
+class MockPerfVLMDataset(Dataset):
+    """Pre-computed fixed-length VLM dataset for throughput benchmarking.
+
+    Every ``__getitem__`` call returns the identical pre-computed sample.
+    The bound ``collate_fn`` stacks tensors and wraps visual inputs in the
+    format expected by the chosen pipeline.
+    """
+
+    def __init__(
+        self,
+        *,
+        seq_length: int,
+        num_images: int,
+        image_params: _ImageParams,
+        output_format: Literal["vlm", "mimo"],
+        modality_name: str,
+        encoder_name: str,
+        target_length: int,
+        random_seed: int,
+        create_attention_mask: bool,
+    ) -> None:
+        super().__init__()
+        self._target_length = target_length
+        self._output_format = output_format
+        self._modality_name = modality_name
+        self._encoder_name = encoder_name
+
+        ip = image_params
+        total_image_tokens = num_images * ip.tokens_per_image
+
+        if total_image_tokens >= seq_length:
+            raise ValueError(
+                f"num_images={num_images} * tokens_per_image={ip.tokens_per_image} = "
+                f"{total_image_tokens} >= seq_length={seq_length}. "
+                f"Reduce num_images or increase seq_length."
+            )
+
+        gen = torch.Generator().manual_seed(random_seed)
+
+        # --- input_ids: [seq_length] ---
+        input_ids = torch.empty(seq_length, dtype=torch.long)
+        input_ids[:total_image_tokens] = ip.image_token_id
+        text_len = seq_length - total_image_tokens
+        input_ids[total_image_tokens:] = torch.randint(1, ip.vocab_size, (text_len,), generator=gen)
+        self._input_ids = input_ids
+
+        # --- labels: [seq_length] (next-token prediction) ---
+        labels = input_ids.clone()
+        labels[:-1] = input_ids[1:]
+        labels[-1] = IGNORE_INDEX
+        labels[:total_image_tokens] = IGNORE_INDEX
+        self._labels = labels
+
+        # --- loss_mask: [seq_length] ---
+        loss_mask = torch.ones(seq_length, dtype=torch.float32)
+        loss_mask[:total_image_tokens] = 0.0
+        loss_mask[-1] = 0.0
+        self._loss_mask = loss_mask
+
+        # --- position_ids: [seq_length] ---
+        self._position_ids = torch.arange(seq_length, dtype=torch.long)
+
+        # --- attention_mask: [seq_length] ---
+        self._attention_mask = torch.ones(seq_length, dtype=torch.long) if create_attention_mask else None
+
+        # --- visual inputs ---
+        if num_images > 0:
+            single_pv = ip.pixel_values_per_image
+            if single_pv.dim() >= 2:
+                self._pixel_values = torch.randn(
+                    single_pv.shape[0] * num_images, *single_pv.shape[1:], generator=gen
+                )
+            else:
+                self._pixel_values = torch.randn(num_images, *single_pv.shape, generator=gen)
+
+            grid = ip.image_grid_thw_per_image
+            self._image_grid_thw = grid.unsqueeze(0).expand(num_images, -1).contiguous()
+        else:
+            self._pixel_values = None
+            self._image_grid_thw = None
+
+        logger.info(
+            "MockPerfVLMDataset: seq_length=%d, num_images=%d, tokens_per_image=%d, "
+            "text_tokens=%d, output_format=%s",
+            seq_length,
+            num_images,
+            ip.tokens_per_image,
+            text_len,
+            output_format,
+        )
+
+        self.collate_fn = self._collate
+
+    def __len__(self) -> int:
+        return self._target_length
+
+    def __getitem__(self, idx: int) -> Dict[str, Any]:
+        sample: Dict[str, Any] = {
+            "input_ids": self._input_ids,
+            "labels": self._labels,
+            "loss_mask": self._loss_mask,
+            "position_ids": self._position_ids,
+        }
+        if self._attention_mask is not None:
+            sample["attention_mask"] = self._attention_mask
+        if self._pixel_values is not None:
+            sample["pixel_values"] = self._pixel_values
+        if self._image_grid_thw is not None:
+            sample["image_grid_thw"] = self._image_grid_thw
+        return sample
+
+    def _collate(self, batch: List[Dict[str, Any]]) -> Dict[str, Any]:
+        input_ids = torch.stack([item["input_ids"] for item in batch])
+        labels = torch.stack([item["labels"] for item in batch])
+        loss_mask = torch.stack([item["loss_mask"] for item in batch])
+        position_ids = torch.stack([item["position_ids"] for item in batch])
+
+        attention_mask: torch.Tensor | None = None
+        if "attention_mask" in batch[0]:
+            attention_mask = torch.stack([item["attention_mask"] for item in batch])
+
+        result: Dict[str, Any] = {
+            "input_ids": input_ids,
+            "labels": labels,
+            "loss_mask": loss_mask,
+            "position_ids": position_ids,
+        }
+        if attention_mask is not None:
+            result["attention_mask"] = attention_mask
+
+        has_vision = batch[0].get("pixel_values") is not None
+
+        if self._output_format == "vlm":
+            if has_vision:
+                pixel_values = torch.cat([item["pixel_values"] for item in batch])
+                image_grid_thw = torch.cat([item["image_grid_thw"] for item in batch])
+                result["visual_inputs"] = GenericVisualInputs(
+                    pixel_values=pixel_values,
+                    image_grid_thw=image_grid_thw,
+                )
+            else:
+                result["visual_inputs"] = None
+        elif self._output_format == "mimo":
+            if has_vision:
+                pixel_values = torch.cat([item["pixel_values"] for item in batch])
+                image_grid_thw = torch.cat([item["image_grid_thw"] for item in batch])
+                num_vision_patches = int(image_grid_thw.prod(dim=-1).sum().item())
+                result["modality_inputs"] = {
+                    self._modality_name: {
+                        self._encoder_name: {
+                            "hidden_states": pixel_values,
+                            "grid_thw": image_grid_thw,
+                        }
+                    }
+                }
+                result["_num_vision_patches"] = num_vision_patches
+                result["_num_vision_images"] = image_grid_thw.shape[0]
+            else:
+                result["modality_inputs"] = {}
+
+        return result
+
+
+@dataclass(kw_only=True)
+class MockPerfVLMProvider(DatasetProvider):
+    """Fixed-length mock VLM dataset provider for performance benchmarking.
+
+    Uses the HF processor once at build time to auto-detect image token layout
+    and pixel tensor shapes. All subsequent iterations are processor-free,
+    returning identical pre-computed tensors of exactly ``seq_length`` tokens.
+
+    Args:
+        seq_length: Exact sequence length for every sample.
+        num_images: Number of images per sample.
+        hf_processor_path: HF processor/model ID used once to detect image params.
+        image_size: Size of the synthetic probe image (width, height).
+        output_format: ``"vlm"`` for GenericVisualInputs, ``"mimo"`` for modality_inputs dict.
+        modality_name: Top-level modality key in the MIMO modality_inputs dict.
+        encoder_name: Encoder key nested under modality_name in the MIMO modality_inputs dict.
+        vocab_size: Override vocabulary size (auto-detected from tokenizer if None).
+        image_token_id: Override image token ID (auto-detected from processor if None).
+        random_seed: Seed for reproducible random token/pixel generation.
+        create_attention_mask: Whether to include an all-ones attention mask.
+    """
+
+    seq_length: int
+    num_images: int = 1
+    hf_processor_path: str = ""
+    image_size: Tuple[int, int] = (256, 256)
+
+    output_format: Literal["vlm", "mimo"] = "vlm"
+    modality_name: str = "images"
+    encoder_name: str = "vision"
+
+    vocab_size: int | None = None
+    image_token_id: int | None = None
+    random_seed: int = 42
+
+    create_attention_mask: bool = True
+    skip_getting_attention_mask_from_dataset: bool = True
+    dataloader_type: Optional[Literal["single", "cyclic", "external"]] = "single"
+
+    def build_datasets(
+        self, context: DatasetBuildContext
+    ) -> Tuple[Optional[MockPerfVLMDataset], Optional[MockPerfVLMDataset], Optional[MockPerfVLMDataset]]:
+        """Build fixed-length mock datasets for train/valid/test splits."""
+        from transformers import AutoProcessor
+
+        processor = AutoProcessor.from_pretrained(
+            self.hf_processor_path,
+            trust_remote_code=is_safe_repo(
+                trust_remote_code=self.trust_remote_code,
+                hf_path=self.hf_processor_path,
+            ),
+        )
+
+        image_params = _detect_image_params(
+            processor,
+            image_size=self.image_size,
+            vocab_size_override=self.vocab_size,
+            image_token_id_override=self.image_token_id,
+        )
+
+        logger.info(
+            "MockPerfVLMProvider: detected tokens_per_image=%d, image_token_id=%d, "
+            "pixel_values_shape=%s, image_grid_thw=%s, vocab_size=%d",
+            image_params.tokens_per_image,
+            image_params.image_token_id,
+            tuple(image_params.pixel_values_per_image.shape),
+            tuple(image_params.image_grid_thw_per_image.tolist()),
+            image_params.vocab_size,
+        )
+
+        def _maybe_make(size: int, seed_offset: int = 0) -> Optional[MockPerfVLMDataset]:
+            if not size or size <= 0:
+                return None
+            return MockPerfVLMDataset(
+                seq_length=self.seq_length,
+                num_images=self.num_images,
+                image_params=image_params,
+                output_format=self.output_format,
+                modality_name=self.modality_name,
+                encoder_name=self.encoder_name,
+                target_length=size,
+                random_seed=self.random_seed + seed_offset,
+                create_attention_mask=self.create_attention_mask,
+            )
+
+        train_ds = _maybe_make(context.train_samples, seed_offset=0)
+        valid_ds = _maybe_make(context.valid_samples, seed_offset=1000)
+        test_ds = _maybe_make(context.test_samples, seed_offset=2000)
+
+        return train_ds, valid_ds, test_ds
