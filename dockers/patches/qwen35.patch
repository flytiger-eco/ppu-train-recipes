+"""Tests for Qwen3VLCPVisionSubmodules — CP-as-DP splitting in MIMO mode."""
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+import torch
+
+from megatron.bridge.models.qwen_vl.modelling_qwen3_vl.mimo_vision_submodules import Qwen3VLCPVisionSubmodules
+
+
+def _make_encoder(cp_size: int = 1, cp_rank: int = 0, hidden_dim: int = 64, spatial_merge_size: int = 2):
+    """Create a mock encoder with a pg_collection and spatial_merge_size."""
+    encoder = MagicMock()
+    encoder.spatial_merge_size = spatial_merge_size
+
+    config = SimpleNamespace(out_hidden_size=hidden_dim)
+    encoder.config = config
+
+    if cp_size > 1:
+        cp_group = MagicMock()
+        pg = SimpleNamespace(cp=cp_group)
+    else:
+        pg = SimpleNamespace(cp=None)
+    encoder.pg_collection = pg
+    return encoder
+
+
+class TestHandlesCPGatherProperty:
+    def test_false_when_vision_dp_when_cp_disabled(self):
+        encoder = _make_encoder(cp_size=4)
+        submodule = Qwen3VLCPVisionSubmodules(
+            encoders={"qwen_visual": encoder},
+            vision_dp_when_cp=False,
+        )
+        assert submodule.handles_cp_gather is False
+
+    @patch("torch.distributed.get_world_size", return_value=4)
+    def test_true_when_cp_greater_than_1(self, mock_ws):
+        encoder = _make_encoder(cp_size=4)
+        submodule = Qwen3VLCPVisionSubmodules(
+            encoders={"qwen_visual": encoder},
+            vision_dp_when_cp=True,
+        )
+        assert submodule.handles_cp_gather is True
+
+    @patch("torch.distributed.get_world_size", return_value=1)
+    def test_false_when_cp_equals_1(self, mock_ws):
+        encoder = _make_encoder(cp_size=4)
+        submodule = Qwen3VLCPVisionSubmodules(
+            encoders={"qwen_visual": encoder},
+            vision_dp_when_cp=True,
+        )
+        assert submodule.handles_cp_gather is False
+
+    def test_false_when_no_pg_collection(self):
+        encoder = MagicMock()
+        encoder.pg_collection = None
+        encoder.spatial_merge_size = 2
+        submodule = Qwen3VLCPVisionSubmodules(
+            encoders={"qwen_visual": encoder},
+            vision_dp_when_cp=True,
+        )
+        assert submodule.handles_cp_gather is False
+
+
+class TestEncodeDelegatesToSuper:
+    def test_delegates_when_no_cp(self):
+        hidden_dim = 64
+        seq_len = 100
+        encoder = _make_encoder(cp_size=1, hidden_dim=hidden_dim)
+        output_tensor = torch.randn(seq_len, hidden_dim)
+        encoder.return_value = output_tensor
+
+        submodule = Qwen3VLCPVisionSubmodules(
+            encoders={"qwen_visual": encoder},
+            vision_dp_when_cp=False,
+        )
+
+        result = submodule.encode({"qwen_visual": {"hidden_states": torch.randn(400, 3), "grid_thw": torch.ones(4, 3)}})
+        assert len(result) == 1
+        assert result[0].shape == (seq_len, hidden_dim)
+
+    def test_empty_batch_returns_empty(self):
+        submodule = Qwen3VLCPVisionSubmodules(
+            encoders={"qwen_visual": _make_encoder()},
+            vision_dp_when_cp=True,
+        )
+        result = submodule.encode({})
+        assert result == []
+
+
+class TestEncodeSplitsAndGathers:
+    @patch("torch.distributed.get_rank", return_value=0)
+    @patch("torch.distributed.get_world_size", return_value=2)
+    @patch("torch.distributed.all_gather")
+    def test_cp2_splits_and_gathers(self, mock_all_gather, mock_ws, mock_rank):
+        hidden_dim = 64
+        cp_size = 2
+        num_images = 4
+        pixels_per_image = 100
+
+        encoder = _make_encoder(cp_size=cp_size, cp_rank=0, hidden_dim=hidden_dim)
+
+        def fake_encoder_forward(**kwargs):
+            seq_len = kwargs["hidden_states"].size(0) // (2**2)
+            return torch.randn(seq_len, hidden_dim)
+
+        encoder.side_effect = fake_encoder_forward
+
+        def fake_all_gather(output_list, input_tensor, group=None):
+            for i, t in enumerate(output_list):
+                t.copy_(torch.randn_like(t))
+
+        mock_all_gather.side_effect = fake_all_gather
+
+        submodule = Qwen3VLCPVisionSubmodules(
+            encoders={"qwen_visual": encoder},
+            vision_dp_when_cp=True,
+        )
+
+        pixel_values = torch.randn(num_images * pixels_per_image, 3)
+        grid_thw = torch.tensor([[1, 10, 10]] * num_images, dtype=torch.long)
+
+        result = submodule.encode({
+            "qwen_visual": {"hidden_states": pixel_values, "grid_thw": grid_thw},
+        })
+
+        assert len(result) == 1
+        encoder.assert_called_once()
+        mock_all_gather.assert_called_once()
+
+    def test_raises_on_missing_encoder_key(self):
+        submodule = Qwen3VLCPVisionSubmodules(
+            encoders={"qwen_visual": _make_encoder()},
+            vision_dp_when_cp=True,
+        )
+        with pytest.raises(ValueError, match="No inputs found"):
+            submodule.encode({"nonexistent": {"hidden_states": torch.randn(10, 3)}})
+
+
+class TestRunEncoder:
+    def test_flattens_3d_output(self):
+        encoder = MagicMock()
+        encoder.return_value = torch.randn(2, 50, 64)
+        result = Qwen3VLCPVisionSubmodules._run_encoder(encoder, {"hidden_states": torch.randn(100, 3)})
+        assert result.shape == (100, 64)
+
+    def test_handles_tuple_output(self):
+        encoder = MagicMock()
+        encoder.return_value = (torch.randn(50, 64), {"aux": "data"})
+        result = Qwen3VLCPVisionSubmodules._run_encoder(encoder, {"hidden_states": torch.randn(50, 3)})
+        assert result.shape == (50, 64)
+
+    def test_keeps_2d_output(self):
+        encoder = MagicMock()
+        encoder.return_value = torch.randn(50, 64)
+        result = Qwen3VLCPVisionSubmodules._run_encoder(encoder, {"hidden_states": torch.randn(50, 3)})
+        assert result.shape == (50, 64)
