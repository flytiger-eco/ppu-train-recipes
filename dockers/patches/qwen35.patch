+    def test_num_vision_images_corrects_multi_image_attention(self):
+        """Multi-image samples must use per-image patch count for quadratic attention.
+
+        With 2 images of 676 patches each (total 1352), the old code divides by
+        batch_size=1 giving patches_per_image=1352 and attention ~ 1352^2.
+        The fix divides by num_vision_images=2 giving patches_per_image=676
+        and attention ~ 2*676^2, which is 2x smaller.
+        """
+        cfg_llm = self._llm_cfg()
+        cfg_vlm = MockConfigContainer(
+            model=MockModelConfig(
+                **{k: v for k, v in cfg_llm.model.__dict__.items() if k != "vision_config"},
+                vision_config=MockVisionConfig(
+                    depth=2,
+                    hidden_size=128,
+                    num_heads=8,
+                    intermediate_size=256,
+                    spatial_merge_size=2,
+                    out_hidden_size=128,
+                ),
+            )
+        )
+        batch_size = 1
+        total_patches = 1352  # 2 images * 676 patches
+        num_images = 2
+
+        flops_old = num_floating_point_operations(
+            cfg_vlm, batch_size=batch_size, num_vision_patches=total_patches,
+        )
+        flops_fixed = num_floating_point_operations(
+            cfg_vlm, batch_size=batch_size, num_vision_patches=total_patches,
+            num_vision_images=num_images,
+        )
+
+        assert flops_fixed < flops_old, "Multi-image fix must reduce ViT FLOPS"
+
+        vit_old = flops_old - num_floating_point_operations(cfg_vlm, batch_size=batch_size)
+        vit_fixed = flops_fixed - num_floating_point_operations(cfg_vlm, batch_size=batch_size)
+
+        vit_direct = vit_flops(cfg_vlm, batch_size=num_images, num_patches=total_patches / num_images)
+        assert vit_fixed == vit_direct, (
+            "ViT FLOPS with num_vision_images must match vit_flops(batch_size=num_images, patches_per_image)"
+        )
+
+    def test_num_vision_images_fallback_to_batch_size(self):
+        """When num_vision_images=0 (default), behaviour matches the legacy path."""
+        cfg_llm = self._llm_cfg()
+        cfg_vlm = MockConfigContainer(
+            model=MockModelConfig(
+                **{k: v for k, v in cfg_llm.model.__dict__.items() if k != "vision_config"},
+                vision_config=MockVisionConfig(
+                    depth=2, hidden_size=128, num_heads=8,
+                    intermediate_size=256, spatial_merge_size=2, out_hidden_size=128,
+                ),
+            )
+        )
+        flops_default = num_floating_point_operations(
+            cfg_vlm, batch_size=2, num_vision_patches=128,
+        )
+        flops_explicit_zero = num_floating_point_operations(
+            cfg_vlm, batch_size=2, num_vision_patches=128, num_vision_images=0,
+        )
+        assert flops_default == flops_explicit_zero
+
 
