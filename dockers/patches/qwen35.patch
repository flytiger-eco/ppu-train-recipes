+class CUDAPrefetchIterator:
+    """Prefetch data batches to GPU on a dedicated copy stream.
+
+    Overlaps H2D transfer of the next batch with compute on the current batch.
+    The copy engine is independent of SMs, so this overlaps even when SMs are
+    fully utilized. Requires ``pin_memory=True`` in the DataLoader.
+    """
+
+    def __init__(self, data_iterator: Iterable) -> None:
+        self._iter = data_iterator
+        self._stream = torch.cuda.Stream()
+        self._next_batch: dict | None = None
+        self._exhausted = False
+        self._prefetch()
+
+    def _transfer_batch(self, batch: dict) -> dict:
+        for key, val in batch.items():
+            if val is None:
+                continue
+            if isinstance(val, torch.Tensor):
+                batch[key] = val.cuda(non_blocking=True)
+            elif hasattr(val, "__dict__"):
+                for k, v in val.__dict__.items():
+                    if isinstance(v, torch.Tensor):
+                        val.__dict__[k] = v.cuda(non_blocking=True)
+        return batch
+
+    def _prefetch(self) -> None:
+        if self._exhausted:
+            return
+        try:
+            batch = next(self._iter)
+        except StopIteration:
+            self._next_batch = None
+            self._exhausted = True
+            return
+        with torch.cuda.stream(self._stream):
+            self._next_batch = self._transfer_batch(batch)
+
+    def __next__(self) -> dict:
+        torch.cuda.current_stream().wait_stream(self._stream)
+        if self._next_batch is None:
+            raise StopIteration
+        batch = self._next_batch
+        self._prefetch()
+        return batch
+
+    def __iter__(self) -> "CUDAPrefetchIterator":
+        return self
+
+
+_prefetch_state: dict[str, Any] = {"source_id": None, "prefetch_iter": None}
+
+
+def _get_prefetch_iterator(data_iterator: Iterable) -> CUDAPrefetchIterator:
+    """Return a cached CUDAPrefetchIterator for the given data_iterator."""
+    iter_id = id(data_iterator)
+    if _prefetch_state["source_id"] != iter_id:
+        _prefetch_state["source_id"] = iter_id
+        _prefetch_state["prefetch_iter"] = CUDAPrefetchIterator(data_iterator)
+    return _prefetch_state["prefetch_iter"]
+
 
 
