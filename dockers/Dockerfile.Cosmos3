# syntax=docker/dockerfile:1.6
ARG BASE_IMAGE=pkg.flytiger-eco.com/docker_release/pytorch:sdk2.2.0-2.10.0-ubuntu24.04-cuda13.0-py312-20261001
FROM ${BASE_IMAGE}

ARG COSMOS_REPO=https://github.com/NVIDIA/cosmos-framework.git
ARG COSMOS_REF=300faa14daab3910be9d303c31708a0a1d6e4371

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PYTORCH_ENABLE_PPU_ELEMENTWISE_OPT=True \
    COSMOS_FRAMEWORK_ROOT=/workspace/cosmos-framework

SHELL ["/bin/bash", "-lc"]

RUN sed -i -E 's|^URIs:.*|URIs: https://mirrors.aliyun.com/ubuntu/|' \
        /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg git git-lfs \
    && rm -rf /var/lib/apt/lists/*

# Install into the container's system Python. No virtual environment is used.
RUN python -m pip install --upgrade pip \
    && python -m pip install --upgrade \
        "huggingface_hub==0.36.2" "transformers==4.57.6" "datasets==4.8.5" \
        "einops==0.8.2" "attrs==26.1.0" "cffi==2.1.0" "click==8.4.2" \
        "filelock==3.32.2" "lark==1.3.1" "protobuf==6.33.6" "psutil==7.2.2" \
        "pyarrow==25.0.0" "python-dateutil==2.9.0.post0" "setuptools==80.10.2" \
        "tzdata==2025.3" \
    && python -m pip install \
        "av==15.1.0" "torchcodec==0.10.0" "diffusers==0.37.1" \
        "multi-storage-client==0.50.0" "webdataset==1.0.2" \
        "hydra-core==1.3.4" "omegaconf==2.3.1" "antlr4-python3-runtime==4.9.3" \
        "loguru==0.7.3" "cattrs==26.1.0" "tyro==1.0.15" "typer==0.27.0" \
        "rich==15.0.0" "termcolor==3.3.0" "deepdiff==8.6.2" \
        "matplotlib==3.11.1" "opencv-python-headless==4.13.0.92" \
        "imageio==2.37.4" "imageio-ffmpeg==0.6.0" "wandb==0.24.2" \
        "qwen-vl-utils==0.0.14" "sentry-sdk==2.66.1" "uv==0.12.1" \
        "obstore==0.8.2" "draccus==0.10.0" "gymnasium==1.3.0" \
    && python -m pip install --upgrade "peft==0.18.1" \
    && python -m pip install --no-deps "lerobot==0.6.0" \
    && python -m pip install \
        "boto3==1.43.62" "botocore==1.43.62" "s3transfer==0.19.2" "jmespath==1.1.0" \
        hatchling editables \
    && (python -m pip uninstall -y kernels || true)

# Re-pin versions that transitive dependencies may otherwise upgrade.
RUN python -m pip install --upgrade \
        "huggingface_hub==0.36.2" "numpy==1.26.4" "diffusers==0.37.1"

# Apply the M890 training changes on top of the pinned official GitHub commit.
COPY dockers/patches/cosmos3.patch /tmp/cosmos3.patch
RUN rm -f /root/.gitconfig \
    && git clone --filter=blob:none "${COSMOS_REPO}" "${COSMOS_FRAMEWORK_ROOT}" \
    && git -C "${COSMOS_FRAMEWORK_ROOT}" checkout "${COSMOS_REF}" \
    && git -C "${COSMOS_FRAMEWORK_ROOT}" apply --check /tmp/cosmos3.patch \
    && git -C "${COSMOS_FRAMEWORK_ROOT}" apply /tmp/cosmos3.patch \
    && rm /tmp/cosmos3.patch \
    && python -m pip install --no-deps -e "${COSMOS_FRAMEWORK_ROOT}/packages/diffusers-cosmos3" \
    && python -m pip install --no-deps -e "${COSMOS_FRAMEWORK_ROOT}"

RUN python -c "import cosmos_framework, diffusers, peft, transformers, datasets, av, torchcodec, hydra, obstore; assert diffusers.__version__ == '0.37.1'; print('Cosmos3 dependencies import ok')"

WORKDIR /workspace/cosmos-framework
CMD ["/bin/bash"]
